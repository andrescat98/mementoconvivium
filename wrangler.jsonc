{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mementoconvivium",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "TURSO_URL": "libsql://mementoconvivium-andrescat98.aws-eu-west-1.turso.io"
  },
  // Secrets (wrangler secret put …, in locale .dev.vars): TURSO_TOKEN, ADMIN_PASSWORD
  "ratelimits": [
    // Login /admin: max 5 tentativi al minuto per IP
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
