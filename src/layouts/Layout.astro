---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSettings } from "../lib/db";
import { googleFontsHref, SITE_FONTS_HREF } from "../lib/format";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    // href di un font Google specifico per la pagina (es. il font del nome personaggio)
    fontHref?: string;
    image?: string; // anteprima social (copertina evento); default /og-image.jpg
}

const s = await getSettings();
// pagine fisse: titolo, descrizione e immagine social da /admin → Impostazioni sito → Google e social
const seo = s.seo[Astro.url.pathname.replace(/\/$/, "") || "/"];
const {
    title = "Memento Convivium",
    description = "Cene con delitto a tema storico. Un banchetto. Un mistero. Una notte che non dimenticherai.",
    fontHref,
    image,
} = { ...Astro.props, ...(seo?.title && { title: seo.title }), ...(seo?.description && { description: seo.description }), ...(seo?.image && { image: seo.image.src }) };

// font scelti nello stile delle sezioni del sito e dei blocchi di home e pagine nuove
const blocks = [...s.home, ...s.pagine.flatMap((p) => p.blocks)];
const sezFonts = googleFontsHref(...Object.values(s.sezioni).map((b) => b.font), ...blocks.map((b) => b.style?.font));
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? "/og-image.jpg", Astro.site);
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- prima del CSS: senza JS le sezioni con animazione d'entrata restano visibili -->
        <script is:inline>document.documentElement.classList.add("js")</script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="theme-color" content="#f5f2ec" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={SITE_FONTS_HREF} />
        {fontHref && <link rel="stylesheet" href={fontHref} />}
        {sezFonts && <link rel="stylesheet" href={sezFonts} />}

        <!-- Open Graph (anteprima link su WhatsApp, Facebook, ecc.) -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Memento Convivium" />
        <meta property="og:locale" content="it_IT" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        {!image && <meta property="og:image:width" content="1200" />}
        {!image && <meta property="og:image:height" content="630" />}

        <!-- Twitter / X -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        {s.analyticsToken && (
            <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: s.analyticsToken })}></script>
        )}
    </head>
    <body>
        <Header />
        {s.banner.text && (
            <aside class="avviso" data-avviso={s.banner.text}>
                {s.banner.href ? <a href={s.banner.href}>{s.banner.text} →</a> : <span>{s.banner.text}</span>}
                <button type="button" aria-label="Chiudi avviso">✕</button>
            </aside>
        )}
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<script>
    // Animazione d'entrata (data-anim, vedi global.css): .in quando la sezione entra nello schermo.
    // Le schede evento nascoste partono quando vengono mostrate.
    const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))),
        { rootMargin: "0px 0px -10% 0px" },
    );
    document.querySelectorAll("[data-anim]").forEach((el) => io.observe(el));

    // Avviso: chiuso resta chiuso finché non cambia il testo
    const avviso = document.querySelector<HTMLElement>("[data-avviso]");
    if (avviso) {
        const k = "mc_avviso";
        try { if (localStorage.getItem(k) === avviso.dataset.avviso) avviso.remove(); } catch {}
        avviso.querySelector("button")?.addEventListener("click", () => {
            avviso.remove();
            try { localStorage.setItem(k, avviso.dataset.avviso!); } catch {}
        });
    }
</script>
