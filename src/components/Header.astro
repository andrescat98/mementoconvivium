---

---

<header class="site-header">
    <div class="header-inner">
        <a href="/" class="logo">
            <span class="logo-ornament">✦</span>
            <span class="logo-text">
                Memento<br /><em>Convivium</em>
            </span>
            <span class="logo-ornament">✦</span>
        </a>

        <nav class="nav" id="mainNav">
            <a href="/#come-funziona">Come funziona</a>
            <a href="/lista-eventi">Lista eventi</a>
            <a href="/#prenota" class="nav-cta">Prenota</a>
        </nav>

        <button
            class="nav-toggle"
            aria-label="Apri menu"
            aria-expanded="false"
            id="navToggle"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
    <div class="greek-border"></div>
</header>

<script>
    const toggle = document.getElementById("navToggle");
    const nav = document.getElementById("mainNav");

    toggle?.addEventListener("click", () => {
        const isOpen = nav?.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.classList.toggle("active");
    });

    // chiudi nav al click su un link (mobile)
    nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            nav.classList.remove("open");
            toggle?.classList.remove("active");
            toggle?.setAttribute("aria-expanded", "false");
        });
    });
</script>

<style>
    /* Override specifici per Header - tutti gli altri stili vengono da Layout.astro */
    .logo {
        color: var(--header-text);
    }

    .logo-ornament {
        color: var(--header-text);
        opacity: 0.5;
    }

    .logo-text em {
        color: var(--ivory);
    }

    .nav a {
        color: var(--header-text);
        opacity: 0.75;
    }

    .nav a:hover {
        opacity: 1;
    }

    .nav-cta {
        border: 1px solid rgba(244, 240, 232, 0.45) !important;
        color: var(--header-text) !important;
        opacity: 1 !important;
    }

    .nav-cta:hover {
        background: var(--header-text) !important;
        color: var(--bg-header) !important;
    }

    /* Mobile */
    @media (max-width: 768px) {
        .nav {
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: calc(100vh - 70px);
            z-index: 99;
            background: linear-gradient(135deg, rgba(20, 20, 20, 0.98) 0%, rgba(30, 25, 20, 0.98) 100%);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            gap: 3rem;
            transform: translateY(-100%);
            transition: transform 0.4s var(--ease-out);
            opacity: 0;
            pointer-events: none;
        }

        .nav.open {
            transform: translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .nav a {
            font-size: 1.5rem;
            opacity: 1;
            width: 100%;
            text-align: center;
            padding: 1rem 0;
        }

        .nav a::after {
            display: none;
        }

        .nav-cta {
            border: 2px solid var(--header-text) !important;
            padding: 1rem 2rem !important;
            font-size: 1.2rem;
        }

        .nav-toggle {
            display: flex;
        }
    }
</style>
