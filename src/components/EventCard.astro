---
// Card di un evento in /lista-eventi (usata anche dall'anteprima in /admin)
import { BOOK_TEXT, dateLabel, nextDate } from "../lib/format";
import type { Evento } from "../lib/schema";

const { evento } = Astro.props as { evento: Evento };
const d = evento.data;
const label = BOOK_TEXT[d.status] ?? "Scopri di più";
const btnClass = d.status === "aperto" ? "btn-primary" : "btn-ghost";
const iso = nextDate(d) ?? d.dates?.[0]?.dateISO;
---

<article class="event-card">
    <div class="event-theme">{d.theme}</div>
    <h3 class="event-title">{d.title}</h3>
    <p class="event-desc">{d.excerpt}</p>
    <div class="event-meta">
        <div class="event-info"><span class="meta-label">Data</span><span>{iso ? dateLabel(iso) : "Da annunciare"}</span></div>
        <div class="event-info"><span class="meta-label">Durata</span><span>{d.duration}</span></div>
    </div>
    <div class="event-card-actions">
        {d.status === "coming-soon" ? (
            <span class={btnClass}>{label}</span>
        ) : (
            <>
                <a href={`/eventi/${evento.id}`} class={btnClass}>{label}</a>
                <a href={`/eventi/${evento.id}`} class="event-detail-link">Scopri la storia →</a>
            </>
        )}
    </div>
</article>
