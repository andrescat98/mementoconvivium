---
// Particelle nere "constellation" reattive a mouse e inclinazione (mobile).
// Vanilla canvas, nessuna dipendenza.
// Uso: mettere <Particles /> dentro un contenitore con position:relative e
// overflow:hidden. Il canvas si dimensiona sul genitore.
---

<canvas class="particles-canvas" aria-hidden="true"></canvas>

<style>
    .particles-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }
</style>

<script>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tilt = { x: 0, y: 0 }; // forza condivisa da inclinazione telefono

    function initParticles(canvas: HTMLCanvasElement) {
        const host = canvas.parentElement;
        if (!host) return;
        const ctx = canvas.getContext("2d")!;
        let w = 0, h = 0;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        let particles: { x: number; y: number; vx: number; vy: number }[] = [];
        const mouse = { x: -999, y: -999 };

        function resize() {
            const r = host!.getBoundingClientRect();
            w = r.width; h = r.height;
            canvas.width = w * dpr;
            canvas.height = h * dpr;
            canvas.style.width = w + "px";
            canvas.style.height = h + "px";
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const count = Math.round((w * h) / 22000); // densità ~ area
            particles = Array.from({ length: count }, () => ({
                x: Math.random() * w,
                y: Math.random() * h,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
            }));
        }

        function frame() {
            ctx.clearRect(0, 0, w, h);
            for (const p of particles) {
                const dx = p.x - mouse.x, dy = p.y - mouse.y;
                const d2 = dx * dx + dy * dy;
                if (d2 < 14400) { // repulsione dal mouse
                    const f = (14400 - d2) / 14400 * 0.6;
                    const d = Math.sqrt(d2) || 1;
                    p.vx += (dx / d) * f;
                    p.vy += (dy / d) * f;
                }
                p.vx += tilt.x; p.vy += tilt.y; // inclinazione (mobile)
                p.x += p.vx; p.y += p.vy;
                p.vx *= 0.96; p.vy *= 0.96; // attrito
                if (Math.abs(p.vx) < 0.05) p.vx += (Math.random() - 0.5) * 0.1;
                if (Math.abs(p.vy) < 0.05) p.vy += (Math.random() - 0.5) * 0.1;
                if (p.x < 0) p.x = w; else if (p.x > w) p.x = 0;
                if (p.y < 0) p.y = h; else if (p.y > h) p.y = 0;
                ctx.fillStyle = "rgba(20,20,20,0.5)";
                ctx.beginPath();
                ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
                ctx.fill();
            }
            for (let i = 0; i < particles.length; i++) { // linee tra vicine
                for (let j = i + 1; j < particles.length; j++) {
                    const a = particles[i], b = particles[j];
                    const dx = a.x - b.x, dy = a.y - b.y;
                    const d2 = dx * dx + dy * dy;
                    if (d2 < 10000) {
                        ctx.strokeStyle = `rgba(20,20,20,${(1 - d2 / 10000) * 0.18})`;
                        ctx.beginPath();
                        ctx.moveTo(a.x, a.y);
                        ctx.lineTo(b.x, b.y);
                        ctx.stroke();
                    }
                }
            }
            raf = requestAnimationFrame(frame);
        }

        let raf = 0;
        host.addEventListener("pointermove", (e) => {
            const r = host.getBoundingClientRect();
            mouse.x = e.clientX - r.left;
            mouse.y = e.clientY - r.top;
        });
        host.addEventListener("pointerleave", () => { mouse.x = mouse.y = -999; });
        window.addEventListener("resize", resize);
        resize();

        if (reduce) {
            frame();
            cancelAnimationFrame(raf); // disegno statico, niente loop
        } else {
            new IntersectionObserver(([entry]) => {
                if (entry.isIntersecting && !raf) raf = requestAnimationFrame(frame);
                else if (!entry.isIntersecting && raf) { cancelAnimationFrame(raf); raf = 0; }
            }).observe(host);
        }
    }

    // Inclinazione del telefono: una sola sorgente, condivisa da tutte le istanze.
    if (!reduce) {
        const onTilt = (e: DeviceOrientationEvent) => {
            if (e.gamma == null || e.beta == null) return;
            tilt.x = Math.max(-1, Math.min(1, e.gamma / 45)) * 0.04;
            tilt.y = Math.max(-1, Math.min(1, (e.beta - 45) / 45)) * 0.04;
        };
        const DOE = window.DeviceOrientationEvent as any;
        if (DOE) {
            window.addEventListener("touchstart", () => {
                if (typeof DOE.requestPermission === "function") {
                    DOE.requestPermission().then((s: string) => {
                        if (s === "granted") window.addEventListener("deviceorientation", onTilt);
                    }).catch(() => {});
                } else {
                    window.addEventListener("deviceorientation", onTilt);
                }
            }, { once: true });
        }
    }

    document.querySelectorAll<HTMLCanvasElement>(".particles-canvas").forEach(initParticles);
</script>
