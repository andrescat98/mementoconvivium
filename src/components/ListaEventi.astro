---
// Contenuto della pagina /lista-eventi: usato dalla pagina vera e dall'anteprima di /admin
import EventCard from "./EventCard.astro";
import Particles from "./Particles.astro";
import Prenota from "./Prenota.astro";
import Sfondo from "./Sfondo.astro";
import { look, nextDate } from "../lib/format";
import type { Evento, Settings } from "../lib/schema";

const { eventi, s } = Astro.props as { eventi: Evento[]; s: Settings };
const ordinati = [...eventi].sort((a, b) => (nextDate(a.data) ?? "9").localeCompare(nextDate(b.data) ?? "9"));
---

<!-- PAGE HERO -->
<section class="page-hero" data-sez="lista-hero" {...look(s.sezioni["lista-hero"])}>
    <Sfondo bg={s.sezioni["lista-hero"]} />
    <div class="page-hero-vignette" aria-hidden="true"></div>
    <div class="page-hero-content">
        <a href="/" class="page-hero-back">← Torna alla home</a>
        <span class="section-label" data-k="listaLabel">{s.listaLabel}</span>
        <h1 data-k="listaTitle">{s.listaTitle}</h1>
        <div class="divider"><span>⬥</span></div>
        <p class="page-hero-sub" data-k="listaSub">{s.listaSub}</p>
    </div>
</section>

<!-- GRIGLIA EVENTI -->
<section class="section eventi" id="eventi" data-sez="lista-eventi" {...look(s.sezioni["lista-eventi"])}>
    <Sfondo bg={s.sezioni["lista-eventi"]} />
    <Particles />
    <div class="container">
        <div class="events-grid">
            {ordinati.map((evento) => <EventCard evento={evento} />)}
        </div>
    </div>
</section>

<Prenota />

<style>
    /* ── Page Hero ──────────────────────────────────── */
    .page-hero {
        position: relative;
        padding: 10rem 2rem 5rem;
        text-align: center;
        overflow: hidden;
    }

    .page-hero-vignette {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            var(--bg) 0%,
            transparent 40%,
            var(--bg) 100%
        );
        pointer-events: none;
    }

    .page-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .page-hero-back {
        font-family: var(--font-title);
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold-dim);
        text-decoration: none;
        margin-bottom: 0.5rem;
        transition: color 0.3s;
        align-self: flex-start;
        position: absolute;
        top: -4rem;
        left: 0;
    }

    .page-hero-back:hover {
        color: var(--gold);
    }

    .page-hero-content h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        color: var(--cream);
        line-height: 1.1;
    }

    .page-hero-sub {
        color: var(--cream-dim);
        font-size: 1rem;
        line-height: 1.8;
        max-width: 480px;
        margin-top: 0.5rem;
    }

    /* eventi section: no top border/bg on this page, the hero already separates */
    .eventi {
        border-top: 1px solid var(--border);
        background: var(--bg-card);
        padding-top: 3rem;
        position: relative;
        overflow: hidden;
    }

    .eventi > .container {
        position: relative;
        z-index: 1;
    }

    @media (max-width: 768px) {
        .page-hero {
            padding: 8rem 1.5rem 3rem;
        }

        .page-hero-back {
            top: -3rem;
        }
    }
</style>
