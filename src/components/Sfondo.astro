---
// Sfondo di una sezione: colore, immagine inquadrata e velo chiaro o scuro. Il genitore deve avere `position: relative`.
import { imgFx, imgStyle, veil } from "../lib/format";
import type { Bg } from "../lib/schema";

const { bg } = Astro.props as { bg?: Bg };
---

{bg && (bg.color || bg.image) && (
    <div class="sfondo" aria-hidden="true" style={[bg.color && `background:${bg.color}`, bg.op !== undefined && `opacity:${bg.op / 100}`].filter(Boolean).join(";") || undefined}>
        {bg.image && <img src={bg.image.src} alt="" loading="lazy" style={[imgStyle(bg.image), imgFx(bg)].filter(Boolean).join(";")} />}
        {!!bg.veil && <span style={`background:${veil(bg)}`}></span>}
    </div>
)}
