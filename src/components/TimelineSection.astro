---
import { getSettings } from "../lib/db";
import type { Evento } from "../lib/schema";
import Particles from "./Particles.astro";
import TimelineCard from "./TimelineCard.astro";

interface Props {
    events: Evento[];
}

const { events } = Astro.props;
const s = await getSettings();

// in ordine di anno storico; senza anno non compaiono
const sorted = events
    .filter((e) => e.data.historicalYear != null)
    .sort((a, b) => a.data.historicalYear! - b.data.historicalYear!);

const zeroInsertAfter = sorted.filter((e) => (e.data.historicalYear ?? 0) < 0).length;
---

<section class="section timeline-section" id="timeline">
    <Particles />
    <div class="container">
        <div class="section-header">
            <span class="section-label" data-k="timelineLabel">{s.timelineLabel}</span>
            <h2 data-k="timelineTitle">{s.timelineTitle}</h2>
            <div class="divider"><span>⬥</span></div>
            <p class="timeline-intro" data-k="timelineIntro">{s.timelineIntro}</p>
        </div>

        <div class="timeline">
            <div class="timeline-axis"></div>

            {sorted.map((evento, i) => {
                const side = i % 2 === 0 ? "left" : "right";
                const isBC = (evento.data.historicalYear ?? 0) < 0;
                const insertZero = !isBC && i === zeroInsertAfter && zeroInsertAfter > 0;

                return (
                    <>
                        {insertZero && (
                            <div class="timeline-zero">
                                <div class="zero-line"></div>
                                <span class="zero-label">⬥ ANNO ZERO ⬥</span>
                                <div class="zero-line"></div>
                            </div>
                        )}
                        <div class={`timeline-item ${side}`}>
                            <div class="timeline-dot">
                                <span class="dot-inner"></span>
                            </div>
                            <TimelineCard evento={evento} />
                        </div>
                    </>
                );
            })}
        </div>
    </div>
</section>
