---
import { actions } from "astro:actions";
import { isAdmin, login as renew } from "../lib/auth";
import { getDeleted, getEvents, getSettings } from "../lib/db";
import { FONT_GROUPS } from "../lib/fonts";
import { BLOCK_TEXT, SEZIONI_TEXT, STATUS_TEXT } from "../lib/format";
import { ANIMS, BLOCKS, EVENTI_SHOW, FX, HERO_ACTIONS, HERO_LAYOUTS, IMG_AR, PADS, SEZIONI, STATUS } from "../lib/schema";
import "../styles/admin.css";

const login = Astro.getActionResult(actions.login);
if ((login && !login.error) || Astro.getActionResult(actions.logout)) return Astro.redirect("/admin");

const authed = await isAdmin(Astro.cookies);
if (authed) await renew(Astro.cookies); // sessione che scorre: altri 30 giorni da oggi
const [eventi, deleted, s] = authed ? await Promise.all([getEvents(true), getDeleted(), getSettings()]) : [[], [], undefined];
// `<` escapato: il JSON finisce dentro un <script>
const json = JSON.stringify({ eventi, deleted, settings: s }).replace(/</g, "\\u003c");
const STATUS_HINT: Record<string, string> = {
    aperto: "si prenota",
    "lista-attesa": "pubblico",
    chiuso: "pubblico",
    "coming-soon": "senza pagina",
    bozza: "nascosto",
};
const ANIM_TEXT: Record<string, string> = { sali: "Sale dal basso", dissolvenza: "Dissolvenza", zoom: "Zoom", sinistra: "Da sinistra", destra: "Da destra" };
const FX_TEXT: Record<string, string> = { ombra: "Ombra", bagliore: "Bagliore dorato", oro: "Oro", inciso: "Inciso", contorno: "Solo contorno" };
const SEO_PAGES = [["/", "Home"], ["/lista-eventi", "Lista eventi"], ["/contatti", "Contatti"], ["/privacy", "Privacy"]];
const PAD_TEXT: Record<string, string> = { compatta: "Compatta", ariosa: "Ariosa", schermo: "A tutto schermo" };
const LAYOUT_TEXT: Record<string, string> = { destra: "Testo a sinistra, date a destra", sinistra: "Date a sinistra, testo a destra", sotto: "Date in una fascia sotto il testo", centro: "Tutto centrato" };
const ALIGNS = [["sinistra", "A sinistra"], ["centro", "Al centro"], ["destra", "A destra"], ["giustificato", "Giustificato"]];
const FS = [["0.85", "Piccolo"], ["1.15", "Grande"], ["1.35", "Molto grande"]];
const LH = [["1.3", "Stretta"], ["1.6", "Media"], ["2", "Ariosa"], ["2.4", "Molto ariosa"]];
const WIDTHS = [["stretta", "Stretta (colonna di lettura)"], ["larga", "Larga"], ["piena", "Tutto lo schermo"]];
const AR_TEXT: Record<string, string> = { quadrata: "Quadrata", orizzontale: "Orizzontale 3:2", panoramica: "Panoramica 16:9", originale: "Intera, non ritagliata" };
const SIZES = [["0.8", "Piccoli"], ["1.2", "Grandi"], ["1.45", "Enormi"]];
const SHOW_TEXT: Record<string, string> = { prossimi: "Prossimi", tutti: "Tutti", passati: "Già fatti" };
// home, pagine nuove ed eventi si scrivono nel loro editor (anteprima dal vivo): qui solo le pagine fisse
const PAGES = [["/lista-eventi", "Lista eventi"], ["/contatti", "Contatti"]];
const HERO_TEXT: Record<string, string> = {
    lista: "Apre l'elenco delle prossime date",
    prossimo: "Porta alla pagina del prossimo evento",
    link: "Porta a un link a scelta",
};
// Anteprime del selettore font: un'unica richiesta a Google Fonts, solo con i caratteri dell'alfabeto
const FONT_TEXT = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzàèéìòù0123456789'·-";
const fontsHref =
    "https://fonts.googleapis.com/css2?" +
    FONT_GROUPS.flatMap(([, fs]) => fs.map(([f]) => "family=" + f.replace(/ /g, "+"))).join("&") +
    "&text=" + encodeURIComponent(FONT_TEXT) + "&display=swap";
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Moderatori · Memento Convivium</title>
</head>
<body>
{!authed || !s ? (
    <form method="POST" action={actions.login} class="login card">
        <h1>Area moderatori</h1>
        <label>Password<input type="password" name="password" required autofocus autocomplete="current-password" /></label>
        {login?.error && <p class="err" role="alert">{login.error.message}</p>}
        <button class="primary">Entra</button>
    </form>
) : (
    <>
    <header class="top">
        <button type="button" id="menu" hidden aria-controls="side">☰ Eventi e pagine</button>
        <strong class="brand">Memento Convivium · Moderatori</strong>
        <button type="button" id="save-top" hidden title="Salva (Ctrl+S)">💾 Salva</button>
        <label class="who">Il tuo nome<input id="who" maxlength="40" placeholder="per la cronologia" autocomplete="nickname" /></label>
        <button type="button" id="media-open" title="Tutte le foto caricate">📁 Libreria foto</button>
        <button type="button" id="backup" title="Scarica tutti gli eventi in un file JSON">Backup</button>
        <a href="/" target="_blank">Sito ↗</a>
        <form method="POST" action={actions.logout}><button>Esci</button></form>
    </header>

    <main class="admin">
        <nav class="side" id="side">
            <button type="button" id="new" class="primary">+ Nuovo evento</button>
            <input id="search" type="search" placeholder="Cerca evento…" aria-label="Cerca evento" />
            <ul id="list"></ul>
            <details id="trash" hidden>
                <summary>Eliminati (<span></span>)</summary>
                <ul></ul>
            </details>
            <p class="side-h">Pagine del sito</p>
            <ul id="page-list"></ul>
            <button type="button" id="new-page">+ Nuova pagina</button>
            <p class="side-h">Tutto il sito</p>
            <a href="#pagine" class="view-link" data-view="pages">✎ Pagine Lista eventi e Contatti</a>
            <a href="#impostazioni" class="view-link" data-view="settings">⚙ Impostazioni sito</a>
        </nav>

        <p id="empty" class="hint">Scegli un evento da modificare o creane uno nuovo.</p>

        <!-- ── Impostazioni del sito: contatti, link, bottone della home -->
        <form id="settings" hidden>
            <div class="bar">
                <div class="bar-title"><h2>Impostazioni sito</h2><small>Contatti, menu e bottone della home: valgono per tutte le pagine</small></div>
<select class="hist" aria-label="Cronologia versioni" title="Versioni salvate: scegline una per ricaricarla, poi Salva per ripristinarla"></select>
            </div>
            <p class="msg" role="status"></p>
            <details open class="sec">
                <summary>Contatti</summary>
                <fieldset>
                    <label>Email<input name="email" type="email" required value={s.email} /></label>
                    <label>Telefono (come si legge)<input name="phone" value={s.phone} placeholder="+39 389 313 7494" /></label>
                    <label>WhatsApp (solo cifre, con prefisso)<input name="whatsapp" value={s.whatsapp} pattern="\d{8,15}" placeholder="393893137494" /></label>
                    <label>Instagram (link)<input name="instagram" type="url" value={s.instagram} /></label>
                    <label class="wide">Link di prenotazione (vuoto = i bottoni "Prenota" aprono una email)<input name="bookingUrl" type="url" value={s.bookingUrl} placeholder="https://…" /></label>
                </fieldset>
            </details>
            <details open class="sec">
                <summary>Menu in alto</summary>
                <fieldset>
                    <div id="nav" class="rows">
                        {s.nav.map((l) => (
                            <div class="row nav">
                                <label>Testo<input name="label" required value={l.label} /></label>
                                <label>Link<input name="href" required value={l.href} /></label>
                                <span class="row-btns"><button type="button" data-up title="Sposta su">↑</button><button type="button" data-down title="Sposta giù">↓</button><button type="button" data-rm title="Rimuovi">✕</button></span>
                            </div>
                        ))}
                    </div>
                    <button type="button" data-add="nav">+ Aggiungi voce</button>
                    <p class="hint">L'ultima voce è evidenziata come bottone. Link interni: <code>/lista-eventi</code>, <code>/#prenota</code>, <code>/eventi/pirati</code>.</p>
                </fieldset>
            </details>
            <details class="sec">
                <summary>🌄 Sfondo di tutte le pagine</summary>
                <div class="bg" data-name="sfondo" data-page data-label="Al posto del marmo su tutto il sito. Home, pagine ed eventi possono averne uno loro. Vuoto = marmo."></div>
            </details>
            <details class="sec">
                <summary>Bottone della home</summary>
                <fieldset>
                    <label>Cosa fa
                        <select name="heroAction">{HERO_ACTIONS.map((a) => <option value={a} selected={a === s.heroAction}>{HERO_TEXT[a]}</option>)}</select>
                    </label>
                    <label data-show="link">Link<input name="heroUrl" type="url" value={s.heroUrl} placeholder="https://…" /></label>
                    <p class="hint">"Prossimo evento" = quello aperto con la data più vicina; se non ce ne sono, apre l'elenco. Il testo del bottone e il motto del footer si cambiano in <a href="#pagine">Testi delle pagine</a>.</p>
                </fieldset>
            </details>
            <details open class="sec">
                <summary>Avviso su tutte le pagine</summary>
                <fieldset>
                    <label class="wide">Testo (vuoto = nessun avviso)<input name="bannerText" maxlength="140" placeholder="Ultimi posti per sabato 14 giugno!" /></label>
                    <label class="wide">Link (facoltativo)<input name="bannerHref" placeholder="/eventi/pirati oppure https://…" /></label>
                    <p class="hint">Compare in basso su ogni pagina; chi lo chiude non lo rivede finché non cambi il testo.</p>
                </fieldset>
            </details>
            <details class="sec">
                <summary>Google e anteprime social</summary>
                <fieldset>
                    <p class="hint">Titolo e descrizione che Google e WhatsApp mostrano per le pagine fisse. Vuoto = quelli predefiniti. Eventi e pagine nuove hanno i loro (estratto e copertina, descrizione della pagina).</p>
                    <div class="rows wide" id="seo">
                        {SEO_PAGES.map(([path, label]) => (
                            <div class="row seo-row" data-path={path}>
                                <div class="img" data-name="seoImage" data-shape="wide" data-label={`${label}: immagine di anteprima`}></div>
                                <label>Titolo<input name="seoTitle" maxlength="70" placeholder={label} /></label>
                                <label class="wide">Descrizione<textarea name="seoDesc" rows="2" maxlength="300"></textarea></label>
                            </div>
                        ))}
                    </div>
                </fieldset>
            </details>
            <details class="sec">
                <summary>Statistiche visite</summary>
                <fieldset>
                    <label class="wide">Token di Cloudflare Web Analytics<input name="analyticsToken" pattern="[0-9a-f]{32}" placeholder="32 caratteri, es. 4f1c…" /></label>
                    <p class="hint">Cloudflare → Analytics &amp; Logs → Web Analytics → Add a site → scegli "manual setup" e copia il valore di <code>token</code>. Le statistiche (visite, pagine, paesi) si vedono lì. Nessun cookie, niente banner.</p>
                </fieldset>
            </details>
        </form>

        <!-- ── Testi delle pagine: la pagina vera in un iframe, testi data-k modificabili al clic -->
        <section id="pages" hidden>
            <div class="bar">
                <div class="bar-title"><h2>Lista eventi e Contatti</h2><small>Clicca su un testo tratteggiato e scrivi (vuoto = testo originale). 🎨 su ogni sezione per lo stile. Home, pagine ed eventi si modificano dal loro editor.</small></div>
                <label class="check"><input type="checkbox" id="phone" /> 📱 Telefono</label>
                <select name="page" aria-label="Pagina">{PAGES.map(([href, label]) => <option value={href}>{label}</option>)}</select>
<select class="hist" aria-label="Cronologia versioni" title="Versioni salvate: scegline una per ricaricarla, poi Salva per ripristinarla"></select>
            </div>
            <p class="msg" role="status"></p>
            <iframe class="page-frame" title="Pagina da modificare"></iframe>
        </section>

        <!-- ── Home e pagine nuove: liste di blocchi -->
        <form id="page-ed" hidden>
            <div class="bar">
                <div class="bar-title"><h2 id="pg-title">Home</h2><small id="pg-meta"></small></div>
                <a id="pg-open" target="_blank">Apri ↗</a>
                <select class="hist" aria-label="Cronologia versioni" title="Versioni salvate: scegline una per ricaricarla, poi Salva per ripristinarla"></select>

                <button type="button" id="pg-del" class="danger">Elimina</button>
            </div>
            <p class="msg" role="status"></p>
            <button type="button" class="unfocus" data-unfocus>← Tutti i blocchi della pagina</button>
            <details open class="sec" id="pg-base">
                <summary>📝 Pagina</summary>
                <fieldset>
                    <label>Titolo<input name="pgTitle" required /></label>
                    <label>Indirizzo (mementoconvivium…/<b>questo</b>)<input name="pgSlug" required pattern="[a-z0-9][a-z0-9\-]*" placeholder="si compila dal titolo" /></label>
                    <label class="wide">Descrizione per Google e anteprime social (WhatsApp, Facebook)<textarea name="pgDesc" rows="2" maxlength="300"></textarea></label>
                    <label class="check"><input type="checkbox" name="pgMenu" /> Nel menu in alto</label>
                    <label class="check"><input type="checkbox" name="pgHidden" /> Nascosta (bozza: la vedono solo i moderatori)</label>
                </fieldset>
            </details>
            <details class="sec">
                <summary>🌄 Sfondo della pagina</summary>
                <div class="bg" data-name="sfondo" data-page data-label="Al posto del marmo, dietro tutta la pagina. Vuoto = lo sfondo del sito (Impostazioni sito)."></div>
            </details>
            <details open class="sec">
                <summary>🧱 Blocchi</summary>
                <div class="blocks-wrap">
                    <div class="blocks"></div>
                    <div class="add-blocks"></div>
                </div>
            </details>
        </form>

        <!-- ── Editor evento -->
        <form id="editor" hidden>
            <div class="bar">
                <div class="bar-title">
                    <h2 id="ed-title">Nuovo evento</h2>
                    <small id="ed-meta"></small>
                </div>
                <a id="preview" target="_blank" hidden>Anteprima ↗</a>
                <select id="history" hidden aria-label="Cronologia versioni"></select>
                <button type="button" id="dup" hidden>Duplica</button>
                <button type="button" id="del" class="danger" hidden>Elimina</button>
            </div>
            <p class="msg" role="status"></p>
            <button type="button" class="unfocus" data-unfocus>← Tutto l'evento</button>

            <button type="button" id="cards-btn" class="cards-btn">🃏 Come appare nelle card: timeline in home e lista eventi</button>

            <details open class="sec" data-ed="hero">
                <summary>📝 Evento</summary>
                <fieldset>
                    <label>Titolo<input name="title" required /></label>
                    <label>Slug (indirizzo /eventi/…)<input name="slug" required pattern="[a-z0-9][a-z0-9\-]*" placeholder="si compila dal titolo" /></label>
                    <label>Tema<input name="theme" required placeholder="Era dei Pirati · 1697" /></label>
                    <label>Stato
                        <select name="status">{STATUS.map((st) => <option value={st}>{STATUS_TEXT[st]} — {STATUS_HINT[st]}</option>)}</select>
                    </label>
                    <label>Durata<input name="duration" required placeholder="2 – 3 ore" /></label>
                    <label class="wide">Estratto (card, intestazione, anteprime e Google)
                        <textarea name="excerpt" rows="3" required></textarea>
                        <small id="excerpt-count"></small>
                    </label>
                </fieldset>
            </details>

            <details open class="sec" data-ed="hero">
                <summary>📅 Date e prezzi</summary>
                <fieldset>
                    <div id="dates" class="rows"></div>
                    <button type="button" data-add="date">+ Aggiungi data</button>
                    <p class="hint">Senza date la pagina mostra "Da annunciare" con luogo e quota generici:</p>
                    <label>Luogo generico<input name="location" /></label>
                    <label>Quota generica<input name="price" /></label>
                    <label class="wide">Cosa include (una voce per riga)<textarea name="includes" rows="3"></textarea></label>
                </fieldset>
            </details>

            <details class="sec" data-ed="hero">
                <summary>🖼 Intestazione</summary>
                <fieldset>
                    <div class="img" data-name="cover" data-shape="wide" data-preview data-label="Copertina (anche card e anteprime social)"></div>
                    <label>Disposizione
                        <select name="heroLayout">{HERO_LAYOUTS.map((l) => <option value={l === "destra" ? "" : l}>{LAYOUT_TEXT[l]}</option>)}</select>
                    </label>
                    <label>Copertina
                        <select name="coverMode"><option value="">Sfumata a destra</option><option value="pieno">A tutto sfondo</option></select>
                    </label>
                    <div class="font-field">
                        <label>Font dei titoli (intestazione, schede e pulsanti)<input name="titleFont" placeholder="predefinito" /></label>
                        <button type="button" data-font="titleFont">Scegli…</button>
                        <p class="font-sample" data-sample="titleFont"></p>
                    </div>
                </fieldset>
                <div class="bg" data-name="heroStyle" data-label="Stile e altezza dell'intestazione: il colore sta sotto la copertina. Le schede ne ereditano colori, testo e impaginazione."></div>
            </details>

            <details open class="sec">
                <summary>📑 Schede</summary>
                <fieldset>
                    <div id="tabs" class="rows"></div>
                    <div class="add-tabs wide">
                        <span class="hint">Aggiungi scheda:</span>
                        <button type="button" data-add="tab" data-preset="storia">La storia</button>
                        <button type="button" data-add="tab" data-preset="abiti">Gli abiti dell'epoca</button>
                        <button type="button" data-add="tab" data-preset="personaggi">Personaggi</button>
                        <button type="button" data-add="tab" data-preset="galleria">Galleria</button>
                        <button type="button" data-add="tab" data-preset="testo">Testo libero</button>
                    </div>
                    <div class="font-field">
                        <label>Font del nome nel ritratto a schermo intero<input name="characterFont" placeholder="predefinito" /></label>
                        <button type="button" data-font="characterFont">Scegli…</button>
                        <p class="font-sample" data-sample="characterFont"></p>
                    </div>
                    <details class="bg-wrap wide"><summary>🎨 Stile di tutte le schede</summary><div class="bg" data-name="background" data-label="Parte dallo stile dell'intestazione; ogni scheda può cambiarne una parte (🎨 nella scheda)."></div></details>
                </fieldset>
            </details>

            <details class="sec">
                <summary>🌄 Sfondo della pagina</summary>
                <div class="bg" data-name="sfondo" data-page data-label="Al posto del marmo, dietro tutta la pagina dell'evento. Vuoto = lo sfondo del sito (Impostazioni sito → Sfondo di tutte le pagine)."></div>
            </details>

            <details class="sec">
                <summary>🏛 Partecipa, menu e piè di pagina</summary>
                <fieldset>
                    <label class="check wide"><input type="checkbox" name="noPrenota" /> Nascondi il box "Partecipa" in fondo a questo evento</label>
                    <p class="hint">Sono parti comuni a tutto il sito: i loro testi si scrivono cliccandoli nell'anteprima (🎨 per lo stile) e cambiano ovunque. Voci del menu e contatti: <a href="#impostazioni">⚙ Impostazioni sito</a>.</p>
                </fieldset>
            </details>

            <details class="sec" data-ed="cards">
                <summary>🃏 Card della timeline</summary>
                <fieldset>
                    <label>Anno storico (negativo = a.C.)<input name="historicalYear" type="number" step="1" /></label>
                    <label>Etichetta anno<input name="yearLabel" placeholder="1697" /></label>
                    <label>Epoca<input name="era" /></label>
                    <label>Luogo storico<input name="place" /></label>
                    <div class="img" data-name="timelineImage" data-shape="wide" data-preview data-label="Immagine della card (vuota = copertina)"></div>
                </fieldset>
            </details>

            <details class="sec">
                <summary>📸 Foto delle serate passate</summary>
                <fieldset>
                    <div id="serate" class="rows"></div>
                    <button type="button" data-add="serata">+ Aggiungi serata</button>
                    <p class="hint">Si vedono con il blocco <b>❖ Foto delle serate</b>: in una scheda di questo evento, oppure in una pagina del sito (es. "Galleria") con le foto di tutti gli eventi e un filtro.</p>
                </fieldset>
            </details>
        </form>

        <!-- ── Anteprima dal vivo di evento e pagine (a destra del form): clic su un blocco = sue impostazioni a sinistra -->
        <section id="live" hidden>
            <div class="live-bar">
                <span class="hint">Anteprima dal vivo, coi dati non salvati: clicca una parte per modificarla</span>
                <label class="check"><input type="checkbox" id="live-phone" /> 📱 Telefono</label>
            </div>
            <div class="prev live"><iframe title="Anteprima dal vivo"></iframe></div>
        </section>
    </main>

    <!-- ── Inquadratura immagine -->
    <dialog id="crop" class="dlg">
        <h3>Inquadra l'immagine</h3>
        <p class="hint">Clicca (o trascina) sul punto che deve restare sempre visibile, poi regola lo zoom.</p>
        <div class="crop-body">
            <div class="crop-src"><img alt="" /><span class="crop-dot"></span></div>
            <div class="crop-side">
                <span class="hint">Come apparirà</span>
                <span class="thumb crop-prev"><img alt="" /></span>
                <label>Zoom <output></output><input type="range" min="1" max="3" step="0.05" name="zoom" /></label>
                <button type="button" data-reset>Centra</button>
            </div>
        </div>
        <div class="prev" hidden><iframe title="Anteprima sul sito"></iframe></div>
        <div class="dlg-btns"><button type="button" data-close>Annulla</button><button type="button" class="primary" data-ok>Applica</button></div>
    </dialog>

    <dialog id="sez-dlg" class="dlg">
                <form method="dialog">
                    <h3>Stile della sezione</h3>
                    <div class="bg"></div>
                    <p class="row-btns"><button value="ok" class="primary">Applica</button><button value="">Annulla</button></p>
                </form>
            </dialog>

    <!-- ── Card dell'evento (timeline e lista eventi) coi dati non salvati -->
    <dialog id="cards-dlg" class="dlg">
        <h3>Come appare l'evento nelle card</h3>
        <p class="hint">Timeline in home (computer e telefono) e lista eventi, coi dati non ancora salvati.</p>
        <div class="prev"><iframe title="Anteprima delle card"></iframe></div>
        <div class="dlg-btns"><button type="button" data-close>Chiudi</button></div>
    </dialog>

    <!-- ── Libreria foto -->
    <dialog id="media" class="dlg">
        <h3>Libreria foto</h3>
        <p class="hint media-hint"></p>
        <div class="media-bar">
            <button type="button" data-f="all" class="on">Tutte</button>
            <button type="button" data-f="free">Non usate</button>
            <button type="button" data-pickmulti hidden>Aggiungi</button>
        </div>
        <div class="media-grid"></div>
        <div class="dlg-btns"><button type="button" data-close>Chiudi</button></div>
    </dialog>

    <!-- ── Selettore font Google -->
    <dialog id="fonts" class="dlg" data-href={fontsHref}>
        <h3>Scegli un font</h3>
        <input type="search" placeholder="Cerca font…" aria-label="Cerca font" />
        <div class="font-list">
            <button type="button" data-pick="">Predefinito del sito</button>
            {FONT_GROUPS.map(([g, fs]) => (
                <section>
                    <h4>{g}</h4>
                    {fs.map(([f, fb]) => (
                        <button type="button" data-pick={`${f}, ${fb}`}>
                            <small>{f}</small>
                            <span style={`font-family:'${f}',${fb}`}></span>
                        </button>
                    ))}
                </section>
            ))}
        </div>
        <p class="hint">Va bene qualunque font di <a href="https://fonts.google.com" target="_blank">Google Fonts</a>: scrivine il nome esatto nel campo.</p>
        <div class="dlg-btns"><button type="button" data-close>Chiudi</button></div>
    </dialog>

    <template id="tpl-item">
        <li><a><span class="t"></span><small><span class="st"></span> <span class="nd"></span></small></a></li>
    </template>
    <template id="tpl-btns">
        <span class="row-btns">
            <button type="button" data-up title="Sposta su">↑</button>
            <button type="button" data-down title="Sposta giù">↓</button>
            <button type="button" data-rm title="Rimuovi">✕</button>
        </span>
    </template>
    <template id="tpl-nav">
        <div class="row nav">
            <label>Testo<input name="label" required /></label>
            <label>Link<input name="href" required /></label>
        </div>
    </template>
    <template id="tpl-date">
        <div class="row date">
            <label>Data<input type="date" name="dateISO" required /><small data-dl></small></label>
            <label>Luogo<input name="location" /></label>
            <label>Quota<input name="price" /></label>
        </div>
    </template>
    <template id="tpl-char">
        <div class="row char">
            <div class="img" data-name="portrait" data-shape="circle"></div>
            <label>Nome<input name="name" required /></label>
            <label>Ruolo<input name="role" required /></label>
            <label class="wide">Indizio<textarea name="hint" rows="2" required></textarea></label>
        </div>
    </template>
    <template id="tpl-shot">
        <div class="row shot">
            <div class="img" data-name="shot" data-shape="photo"></div>
            <label>Didascalia<input name="caption" /></label>
        </div>
    </template>
    <template id="tpl-tab">
        <details class="tab-ed" open>
            <summary>
                <span class="tab-name"></span>
                <span class="row-btns">
                    <button type="button" data-up title="Sposta su">↑</button>
                    <button type="button" data-down title="Sposta giù">↓</button>
                    <button type="button" data-rm title="Rimuovi scheda">✕</button>
                </span>
            </summary>
            <div class="grid">
                <label class="wide">Titolo della scheda<input name="tabTitle" required /></label>
                <div class="wide blocks-wrap">
                    <div class="blocks"></div>
                    <div class="add-blocks"></div>
                </div>
                <details class="bg-wrap wide"><summary>🎨 Stile della scheda</summary><div class="bg" data-label="Quello che lasci vuoto viene dallo stile predefinito delle schede."></div></details>
            </div>
        </details>
    </template>
    <template id="tpl-add">
        <span class="hint">Aggiungi blocco:</span>
        {BLOCKS.map((t) => (
            <button type="button" data-add="block" data-type={t} title={BLOCK_TEXT[t][2]}><span class="ico">{BLOCK_TEXT[t][0]}</span> {BLOCK_TEXT[t][1]}</button>
        ))}
    </template>
    <template id="tpl-block">
        <details class="block-ed" open>
            <summary>
                <span class="ico block-ico"></span>
                <span class="block-name"></span>
                <span class="row-btns">
                    <button type="button" data-hide title="Nascondi o mostra sul sito">👁</button>
                    <button type="button" data-dup title="Duplica">⧉</button>
                    <button type="button" data-up title="Sposta su">↑</button>
                    <button type="button" data-down title="Sposta giù">↓</button>
                    <button type="button" data-rm title="Rimuovi blocco">✕</button>
                </span>
            </summary>
            <div class="grid">
                <label class="wide" data-for="testo galleria personaggi faq bottone video eventi ricordi">Titolo (facoltativo)<input name="bTitle" /></label>
                <label class="wide" data-for="sezione">Quale sezione
                    <select name="key">{SEZIONI.map((k) => <option value={k}>{SEZIONI_TEXT[k]}</option>)}</select>
                </label>
                <p class="hint wide" data-for="sezione">Testi e stile si cambiano direttamente nell'anteprima (clic sul testo, 🎨 per lo stile) e valgono ovunque compaia la sezione.</p>
                <p class="hint wide live-hint" data-for="testo galleria personaggi faq bottone video eventi ricordi">✎ Titolo e testo si scrivono direttamente nell'anteprima a destra; foto: trascinale o incollale dove vuoi.</p>
                <div class="wide md" data-for="testo galleria personaggi faq bottone video eventi ricordi">
                    <div class="md-tools">
                        <span class="hint md-label">Testo</span>
                        <button type="button" data-md="b" title="Grassetto"><b>G</b></button>
                        <button type="button" data-md="i" title="Corsivo"><i>C</i></button>
                        <button type="button" data-md="link">Link</button>
                        <button type="button" data-md="preview" aria-pressed="false">Anteprima</button>
                        <small>Riga vuota = nuovo paragrafo</small>
                    </div>
                    <div class="md-split">
                        <textarea name="bBody" rows="6" aria-label="Testo del blocco"></textarea>
                        <div class="md-out" hidden></div>
                    </div>
                </div>
                <div class="img" data-for="testo" data-name="bImage" data-shape="tall" data-label="Immagine del testo"></div>
                <div class="wide img-opts" data-for="testo">
                    <label>Posizione dell'immagine
                        <select name="side"><option value="">A destra del testo</option><option value="sinistra">A sinistra del testo</option><option value="sopra">Sopra il testo</option><option value="sotto">Sotto il testo</option></select>
                    </label>
                    <label>Forma<select name="imgAr"><option value="">Verticale 4:5</option>{IMG_AR.map((a) => <option value={a}>{AR_TEXT[a]}</option>)}</select></label>
                    <label class="veil">Larghezza <output></output><input type="range" name="imgW" min="0" max="90" step="5" value="0" /></label>
                    <label>Allineamento verticale<select name="valign"><option value="">In alto</option><option value="centro">Al centro</option><option value="basso">In basso</option></select></label>
                </div>
                <div class="wide" data-for="galleria">
                    <div class="rows shots"></div>
                    <label class="file-btn">+ Aggiungi foto (anche più insieme)<input type="file" accept="image/*" multiple data-multi /></label>
                    <button type="button" class="lib-link" data-lib-multi>dalla libreria</button>
                </div>
                <div class="wide" data-for="personaggi">
                    <div class="rows chars"></div>
                    <button type="button" data-add="char">+ Aggiungi personaggio</button>
                </div>
                <div class="wide" data-for="faq">
                    <div class="rows faqs"></div>
                    <button type="button" data-add="faq">+ Aggiungi domanda</button>
                </div>
                <label data-for="bottone">Testo del bottone<input name="label" placeholder="Scopri di più" /></label>
                <label data-for="bottone">Link<input name="href" placeholder="/lista-eventi oppure https://…" /></label>
                <label class="wide" data-for="video">Link YouTube o Vimeo<input name="video" type="url" placeholder="https://www.youtube.com/watch?v=…" /></label>
                <label data-for="eventi">Quali eventi
                    <select name="show">{EVENTI_SHOW.map((v) => <option value={v}>{SHOW_TEXT[v]}</option>)}</select>
                </label>
                <label data-for="eventi">Quanti al massimo<input name="limit" type="number" min="1" max="24" placeholder="tutti" /></label>
                <details class="bg-wrap wide" data-for="testo galleria personaggi faq bottone video eventi ricordi"><summary>🎨 Stile del blocco</summary><div class="bg"></div></details>
            </div>
        </details>
    </template>
    <template id="tpl-serata">
        <div class="row serata">
            <label>Data<input type="date" name="sDate" /></label>
            <label>Luogo<input name="sPlace" /></label>
            <div class="wide">
                <div class="rows shots"></div>
                <label class="file-btn">+ Aggiungi foto (anche più insieme)<input type="file" accept="image/*" multiple data-multi /></label>
                <button type="button" class="lib-link" data-lib-multi>dalla libreria</button>
            </div>
        </div>
    </template>
    <template id="tpl-faq">
        <div class="row faq-row">
            <label class="wide">Domanda<input name="q" required /></label>
            <label class="wide">Risposta<textarea name="a" rows="2" required></textarea></label>
        </div>
    </template>
    <template id="tpl-img">
        <span class="hint img-label"></span>
        <span class="thumb" hidden><img alt="" /></span>
        <input type="hidden" />
        <label class="file"><span>Trascina una foto o <u>sceglila</u></span><input type="file" accept="image/*" /></label>
        <button type="button" class="lib-link" data-lib>dalla libreria</button>
        <span class="img-btns" hidden>
            <button type="button" data-crop>Inquadra</button>
            <button type="button" data-clear>Rimuovi</button>
        </span>
    </template>
    <template id="tpl-bg">
        <span class="hint bg-label"></span>
        <div class="bg-row bg-sez">
            <label>Stile salvato<select name="preset"><option value="">—</option></select></label>
            <button type="button" data-style-save title="Salva questa combinazione con un nome, per riusarla altrove">Salva come stile…</button>
            <button type="button" data-style-del title="Elimina lo stile salvato scelto">Elimina stile</button>
        </div>
        <details class="bg-grp" open>
            <summary>Sfondo</summary>
            <div class="bg-row">
                <label class="check"><input type="checkbox" name="bgOn" /> Colore</label>
                <input type="color" name="bgColor" value="#f5f2ec" aria-label="Colore di sfondo" />
                <label class="veil">Opacità <output></output><input type="range" name="op" min="0" max="100" step="5" value="100" /></label>
                <label class="veil">Velo sull'immagine <output></output><input type="range" name="bgVeil" min="0" max="90" step="5" value="0" /></label>
                <label class="check"><input type="checkbox" name="dark" /> Velo scuro</label>
                <label class="check bg-sez"><input type="checkbox" name="parallax" /> Parallasse</label>
            </div>
            <div class="img" data-name="bgImage" data-shape="wide" data-label="Immagine di sfondo"></div>
        </details>
        <details class="bg-grp bg-sez">
            <summary>Testo</summary>
            <div class="bg-row">
                <label class="check"><input type="checkbox" name="textOn" /> Colore</label>
                <input type="color" name="textColor" value="#f4f0e8" aria-label="Colore del testo" />
                <span class="bg-font"><label>Font dei titoli<input name="font" placeholder="predefinito" /></label><button type="button" data-font>Scegli…</button></span>
                <label>Grandezza titoli<select name="size"><option value="">Normale</option>{SIZES.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
                <label>Allineamento<select name="align"><option value="">Predefinito</option>{ALIGNS.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
                <label>Grandezza testo<select name="fs"><option value="">Normale</option>{FS.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
                <label>Interlinea<select name="lh"><option value="">Normale</option>{LH.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
                <label>Larghezza<select name="w"><option value="">Normale</option>{WIDTHS.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
            </div>
        </details>
        <details class="bg-grp bg-sez">
            <summary>Altezza e spazi <small>(l'altezza si trascina anche dal bordo in basso, nell'anteprima)</small></summary>
            <div class="bg-row">
                <label class="veil">Altezza minima <output></output><input type="range" name="height" min="0" max="100" step="10" value="0" /></label>
                <label>Contenuto<select name="vpos"><option value="">Al centro</option><option value="alto">In alto</option><option value="basso">In basso</option></select></label>
                <label>Spaziatura<select name="pad"><option value="">Normale</option>{PADS.map((p) => <option value={p}>{PAD_TEXT[p]}</option>)}</select></label>
            </div>
        </details>
        <details class="bg-grp bg-sez">
            <summary>Animazione ed effetti</summary>
            <div class="bg-row">
                <label>Animazione d'entrata<select name="anim"><option value="">Nessuna</option>{ANIMS.map((a) => <option value={a}>{ANIM_TEXT[a]}</option>)}</select></label>
                <label>Effetto sui titoli<select name="fx"><option value="">Nessuno</option>{FX.map((f) => <option value={f}>{FX_TEXT[f]}</option>)}</select></label>
            </div>
        </details>
    </template>
    <script type="application/json" id="admin-data" set:html={json} />
    </>
)}

<script>
    import "../scripts/admin.ts";
</script>
</body>
</html>
