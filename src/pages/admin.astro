---
import { actions } from "astro:actions";
import { isAdmin } from "../lib/auth";
import { getEvents } from "../lib/db";
import { STATUS } from "../lib/schema";

const login = Astro.getActionResult(actions.login);
if ((login && !login.error) || Astro.getActionResult(actions.logout)) return Astro.redirect("/admin");

const authed = await isAdmin(Astro.cookies);
const eventi = authed ? await getEvents() : [];
// `<` escapato: il JSON finisce dentro un <script>
const json = JSON.stringify(eventi).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Moderatori · Memento Convivium</title>
</head>
<body>
{!authed ? (
    <form method="POST" action={actions.login} class="login card">
        <h1>Area moderatori</h1>
        <label>Password<input type="password" name="password" required autofocus autocomplete="current-password" /></label>
        {login?.error && <p class="err" role="alert">{login.error.message}</p>}
        <button class="primary">Entra</button>
    </form>
) : (
    <>
    <header class="top">
        <strong>Memento Convivium · Moderatori</strong>
        <a href="/" target="_blank">Vedi il sito ↗</a>
        <form method="POST" action={actions.logout}><button>Esci</button></form>
    </header>
    <main class="admin">
        <nav class="list">
            <button type="button" id="new" class="primary">+ Nuovo evento</button>
            <ul>
                {eventi.map((e) => (
                    <li><a href={`#${e.id}`}>{e.data.title}<small>{e.id} · {e.data.status}</small></a></li>
                ))}
            </ul>
        </nav>

        <p id="empty" class="hint">Scegli un evento da modificare o creane uno nuovo.</p>

        <form id="editor" hidden>
            <div class="bar">
                <h2 id="ed-title">Nuovo evento</h2>
                <a id="preview" target="_blank" hidden>Apri pagina ↗</a>
                <button type="button" id="del" class="danger" hidden>Elimina</button>
                <button class="primary">Salva</button>
            </div>
            <p id="msg" role="status"></p>

            <fieldset>
                <legend>Base</legend>
                <label>Titolo<input name="title" required /></label>
                <label>Slug (URL)<input name="slug" required pattern="[a-z0-9][a-z0-9\-]*" placeholder="es. pirati" /></label>
                <label>Tema<input name="theme" required placeholder="Era dei Pirati · 1697" /></label>
                <label>Stato
                    <select name="status">{STATUS.map((s) => <option>{s}</option>)}</select>
                </label>
                <label>Durata<input name="duration" required placeholder="2 – 3 ore" /></label>
                <label class="wide">Estratto (card e anteprime)<textarea name="excerpt" rows="3" required></textarea></label>
                <label class="wide">Racconto
                    <textarea name="body" rows="12"></textarea>
                    <small>Riga vuota = nuovo paragrafo · **grassetto** · *corsivo* · [testo](https://link)</small>
                </label>
            </fieldset>

            <fieldset>
                <legend>Date</legend>
                <div id="dates" class="rows"></div>
                <button type="button" data-add="date">+ Aggiungi data</button>
                <p class="hint">Se non ci sono date, la pagina mostra luogo e quota generici:</p>
                <label>Luogo generico<input name="location" /></label>
                <label>Quota generica<input name="price" /></label>
                <label class="wide">Cosa include (una voce per riga)<textarea name="includes" rows="3"></textarea></label>
            </fieldset>

            <fieldset>
                <legend>Personaggi</legend>
                <div id="chars" class="rows"></div>
                <button type="button" data-add="char">+ Aggiungi personaggio</button>
                <label>Font nome nel ritratto (Google Fonts)<input name="characterFont" placeholder="Rye, cursive" /></label>
            </fieldset>

            <fieldset>
                <legend>Timeline in home</legend>
                <label>Anno storico (negativo = a.C.)<input name="historicalYear" type="number" step="1" /></label>
                <label>Etichetta anno<input name="yearLabel" placeholder="1697" /></label>
                <label>Epoca<input name="era" /></label>
                <label>Luogo storico<input name="place" /></label>
                <div class="img wide" data-name="timelineImage"></div>
            </fieldset>
        </form>
    </main>

    <template id="tpl-date">
        <div class="row">
            <label>Data<input type="date" name="dateISO" required /></label>
            <label>Luogo<input name="location" /></label>
            <label>Quota<input name="price" /></label>
            <span class="row-btns"><button type="button" data-up title="Sposta su">↑</button><button type="button" data-rm title="Rimuovi">✕</button></span>
        </div>
    </template>
    <template id="tpl-char">
        <div class="row char">
            <div class="img" data-name="portrait"></div>
            <label>Nome<input name="name" required /></label>
            <label>Ruolo<input name="role" required /></label>
            <label class="wide">Indizio<textarea name="hint" rows="2" required></textarea></label>
            <span class="row-btns"><button type="button" data-up title="Sposta su">↑</button><button type="button" data-rm title="Rimuovi">✕</button></span>
        </div>
    </template>
    <template id="tpl-img">
        <img alt="" hidden />
        <input type="hidden" />
        <label class="file">Immagine<input type="file" accept="image/*" /></label>
        <button type="button" data-clear hidden>Rimuovi immagine</button>
    </template>
    <script type="application/json" id="eventi-data" set:html={json} />
    </>
)}

<script>
    import { actions, isInputError } from "astro:actions";
    import type { Evento } from "../lib/schema";

    const form = document.querySelector<HTMLFormElement>("#editor");
    if (form) {
        const $ = <T extends Element = HTMLInputElement>(sel: string, root: ParentNode = form) => root.querySelector<T>(sel)!;
        const eventi: Evento[] = JSON.parse(document.getElementById("eventi-data")!.textContent!);
        const msg = $<HTMLElement>("#msg");
        let current: string | undefined; // slug originale dell'evento aperto
        let dirty = false;

        // ── immagini: ridimensionate e convertite in webp nel browser, poi caricate su Turso
        const MAX_SIDE = 1600;
        async function shrink(file: File): Promise<Blob> {
            const bmp = await createImageBitmap(file);
            const k = Math.min(1, MAX_SIDE / Math.max(bmp.width, bmp.height));
            const c = new OffscreenCanvas(Math.round(bmp.width * k), Math.round(bmp.height * k));
            c.getContext("2d")!.drawImage(bmp, 0, 0, c.width, c.height);
            const webp = await c.convertToBlob({ type: "image/webp", quality: 0.8 });
            // Safari non codifica webp: ripiega su jpeg
            return webp.type === "image/webp" ? webp : c.convertToBlob({ type: "image/jpeg", quality: 0.82 });
        }
        function initImg(box: HTMLElement, url?: string) {
            box.append($<HTMLTemplateElement>("#tpl-img", document).content.cloneNode(true));
            const img = $<HTMLImageElement>("img", box), hidden = $("input[type=hidden]", box), clear = $("[data-clear]", box);
            hidden.name = box.dataset.name!;
            const set = (u = "") => { hidden.value = u; img.src = u; img.hidden = clear.hidden = !u; };
            set(url);
            clear.onclick = () => { set(); dirty = true; };
            $("input[type=file]", box).onchange = async (e) => {
                const input = e.target as HTMLInputElement;
                const file = input.files?.[0];
                if (!file) return;
                say("Caricamento immagine…");
                const blob = await shrink(file);
                const fd = new FormData();
                fd.append("file", new File([blob], "img", { type: blob.type }));
                const { data, error } = await actions.uploadImage(fd);
                input.value = "";
                if (error) return say(error.message, true);
                set(data.url);
                dirty = true;
                say("Immagine caricata. Ricorda di salvare.");
            };
        }

        // ── righe ripetibili (date, personaggi)
        function addRow(kind: "date" | "char", v: Record<string, string | undefined> = {}) {
            const row = $<HTMLTemplateElement>(`#tpl-${kind}`, document).content.firstElementChild!.cloneNode(true) as HTMLElement;
            row.querySelectorAll<HTMLInputElement>("[name]").forEach((el) => (el.value = v[el.name] ?? ""));
            row.querySelectorAll<HTMLElement>(".img").forEach((b) => initImg(b, v[b.dataset.name!]));
            $(`#${kind}s`).append(row);
        }
        form.addEventListener("click", (e) => {
            const b = (e.target as Element).closest("button");
            if (!b) return;
            const row = b.closest(".row");
            if (b.dataset.add) addRow(b.dataset.add as "date" | "char");
            else if (row && "rm" in b.dataset) row.remove();
            else if (row && "up" in b.dataset) row.previousElementSibling?.before(row);
            else return;
            dirty = true;
        });
        form.addEventListener("input", () => (dirty = true));
        addEventListener("beforeunload", (e) => dirty && e.preventDefault());

        // ── carica un evento nel form (undefined = nuovo)
        function open(ev?: Evento) {
            if (dirty && !confirm("Ci sono modifiche non salvate. Continuare?")) return false;
            const d = (ev?.data ?? {}) as Record<string, any>;
            form!.reset();
            form!.querySelectorAll(".rows").forEach((r) => (r.innerHTML = ""));
            form!.querySelectorAll<HTMLElement>(".img").forEach((b) => (b.innerHTML = ""));
            for (const el of form!.querySelectorAll<HTMLInputElement>("fieldset > label > [name]")) {
                el.value = el.name === "includes" ? (d.includes ?? []).join("\n") : String(d[el.name] ?? "");
            }
            $("[name=slug]").value = ev?.id ?? "";
            $("[name=body]").value = ev?.body ?? "";
            $("[name=status]").value = d.status ?? "aperto";
            d.dates?.forEach((x: any) => addRow("date", x));
            d.characters?.forEach((x: any) => addRow("char", x));
            initImg($<HTMLElement>("fieldset > .img"), d.timelineImage);
            current = ev?.id;
            $<HTMLElement>("#ed-title").textContent = d.title ?? "Nuovo evento";
            const preview = $<HTMLAnchorElement>("#preview");
            preview.href = `/eventi/${ev?.id}`;
            preview.hidden = $<HTMLElement>("#del").hidden = !ev;
            form!.hidden = false;
            $<HTMLElement>("#empty", document).hidden = true;
            document.querySelectorAll(".list a").forEach((a) => a.classList.toggle("on", a.getAttribute("href") === `#${ev?.id}`));
            say("");
            dirty = false;
            return true;
        }

        // ── form → payload per l'action saveEvent
        function collect() {
            // senza root: solo i campi diretti dei fieldset (le righe date hanno anche loro "location"/"price")
            const val = (name: string, root?: ParentNode) =>
                (root ?? form!).querySelector<HTMLInputElement>(
                    root ? `[name=${name}]` : `fieldset > label > [name=${name}], fieldset > .img > [name=${name}]`,
                )?.value.trim() || undefined;
            const rows = (id: string) => [...form!.querySelectorAll(`#${id} > .row`)];
            const list = <T,>(a: T[]) => (a.length ? a : undefined);
            const year = val("historicalYear");
            return {
                slug: val("slug") ?? "",
                originalSlug: current,
                body: $("[name=body]").value,
                data: {
                    title: val("title"), theme: val("theme"), status: val("status"),
                    duration: val("duration"), excerpt: val("excerpt"),
                    dates: list(rows("dates").map((r) => ({ dateISO: val("dateISO", r), location: val("location", r), price: val("price", r) }))),
                    location: val("location"), price: val("price"),
                    includes: list($("[name=includes]").value.split("\n").map((s) => s.trim()).filter(Boolean)),
                    characters: list(rows("chars").map((r) => ({ name: val("name", r), role: val("role", r), hint: val("hint", r), portrait: val("portrait", r) }))),
                    characterFont: val("characterFont"),
                    historicalYear: year === undefined ? undefined : Number(year),
                    era: val("era"), yearLabel: val("yearLabel"), place: val("place"),
                    timelineImage: val("timelineImage"),
                },
            };
        }

        function say(text: string, err = false) {
            msg.textContent = text;
            msg.className = err ? "err" : "";
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            say("Salvataggio…");
            const { data, error } = await actions.saveEvent(collect() as any);
            if (error) {
                return say(
                    isInputError(error)
                        ? "Controlla i campi: " + Object.keys(error.fields).join(", ").replace(/data\./g, "")
                        : error.message,
                    true,
                );
            }
            dirty = false;
            location.hash = data.slug;
            location.reload();
        });

        $("#del").onclick = async () => {
            if (!current || !confirm(`Eliminare definitivamente "${current}"?`)) return;
            const { error } = await actions.deleteEvent({ slug: current });
            if (error) return say(error.message, true);
            dirty = false;
            location.hash = "";
            location.reload();
        };

        $<HTMLButtonElement>("#new", document).onclick = () => open() && history.replaceState(null, "", "#");
        const fromHash = () => {
            const ev = eventi.find((x) => x.id === decodeURIComponent(location.hash.slice(1)));
            if (ev && ev.id !== current) open(ev);
        };
        addEventListener("hashchange", fromHash);
        fromHash();
    }
</script>

<style is:global>
    :root {
        --bg: #f5f2ec; --card: #fbfaf7; --ink: #1a1a1a; --dim: #6b6b6b;
        --line: rgba(0, 0, 0, 0.14); --accent: #1a1a1a; --danger: #a12a1f;
        color-scheme: light;
        font: 15px/1.5 system-ui, sans-serif;
        color: var(--ink);
        background: var(--bg);
    }
    * { box-sizing: border-box; }
    body { margin: 0; }
    h1, h2, legend { font-family: Cinzel, Georgia, serif; letter-spacing: 0.04em; }
    input, select, textarea, button { font: inherit; color: inherit; }
    input, select, textarea {
        width: 100%; padding: 0.45rem 0.6rem; border: 1px solid var(--line);
        border-radius: 6px; background: #fff;
    }
    input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible {
        outline: 2px solid var(--accent); outline-offset: 2px;
    }
    textarea { resize: vertical; }
    label { display: grid; gap: 0.25rem; font-size: 0.85rem; color: var(--dim); }
    label small { color: var(--dim); }
    button {
        padding: 0.45rem 0.9rem; border: 1px solid var(--line); border-radius: 6px;
        background: var(--card); cursor: pointer;
    }
    button:hover { border-color: var(--ink); }
    .primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .danger { color: var(--danger); border-color: currentColor; }
    .err { color: var(--danger); }
    .hint { color: var(--dim); font-size: 0.85rem; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; }

    .login { max-width: 22rem; margin: 15vh auto; padding: 2rem; display: grid; gap: 1rem; }
    .login h1 { margin: 0; font-size: 1.3rem; }

    .top {
        position: sticky; top: env(safe-area-inset-top, 0px); z-index: 2;
        display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;
        padding: 0.6rem 1rem; background: #1c1a18; color: #f4f0e8;
    }
    .top a { color: inherit; margin-left: auto; }
    .top button { background: transparent; color: inherit; border-color: rgba(255, 255, 255, 0.3); }

    .admin { display: grid; grid-template-columns: 16rem 1fr; gap: 1.5rem; padding: 1rem; max-width: 80rem; margin: auto; }
    .list { display: grid; gap: 0.75rem; align-content: start; position: sticky; top: 3.5rem; }
    .list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
    .list a { display: grid; padding: 0.5rem 0.7rem; border-radius: 6px; color: inherit; text-decoration: none; }
    .list a:hover, .list a.on { background: var(--card); box-shadow: inset 3px 0 var(--accent); }
    .list small { color: var(--dim); }

    #editor { display: grid; gap: 1.25rem; min-width: 0; }
    .bar {
        display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;
        position: sticky; top: 2.9rem; z-index: 1; padding-block: 0.5rem; background: var(--bg);
    }
    .bar h2 { margin: 0 auto 0 0; font-size: 1.25rem; }
    #msg { margin: 0; min-height: 1.5em; }
    fieldset {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.9rem;
        margin: 0; padding: 1rem; border: 1px solid var(--line); border-radius: 10px; background: var(--card);
    }
    legend { padding: 0 0.4rem; font-weight: 600; }
    .wide, .rows, fieldset > button, fieldset > .hint { grid-column: 1 / -1; }
    fieldset > button { justify-self: start; }
    .rows { display: grid; gap: 0.75rem; }
    .row {
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 0.6rem;
        align-items: end; padding: 0.75rem; border: 1px dashed var(--line); border-radius: 8px;
    }
    .row.char { grid-template-columns: 7rem repeat(2, minmax(9rem, 1fr)) auto; }
    .row.char .img { grid-row: span 2; }
    .row.char .wide { grid-column: 2 / -1; }
    .row-btns { display: flex; gap: 0.3rem; grid-row: 1; grid-column: -2; }
    .row-btns button, .img [data-clear] { padding: 0.3rem 0.55rem; font-size: 0.8rem; }
    .img { display: grid; gap: 0.4rem; align-content: start; }
    .img img { width: 100%; max-width: 16rem; aspect-ratio: 1; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); }
    .img .file input { padding: 0.3rem; font-size: 0.8rem; }

    @media (max-width: 760px) {
        .admin { grid-template-columns: 1fr; }
        .list { position: static; }
        .row, .row.char { grid-template-columns: 1fr; }
        .row.char .img, .row.char .wide, .row-btns { grid-row: auto; grid-column: auto; }
        .bar { top: 5.6rem; }
    }
</style>
</body>
</html>
