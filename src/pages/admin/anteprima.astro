---
// Anteprima per /admin coi componenti e il CSS veri, a partire dai dati non ancora salvati:
// - evento (POST JSON { slug, data }): la pagina vera (header, intestazione, schede coi pulsanti, Partecipa, footer);
//   admin.ts sceglie la scheda visibile. Con `cards: true` solo le card di timeline e lista eventi (bottone in /admin)
// - home o pagina nuova (POST JSON { blocks, sfondo }): header, blocchi, footer, sullo sfondo della pagina
// I testi del sito ([data-k]) e lo stile delle sezioni fisse ([data-sez]) si modificano qui e finiscono nelle impostazioni.
// scripts/admin.ts la carica in un iframe e aggiorna dal vivo l'inquadratura delle immagini.
// Ogni parte modificabile sta in un [data-ed] (display: contents): "hero", "t0" (titolo scheda),
// "t0.2" (blocco 2 della scheda 0), "2" (blocco 2 della pagina). Gli indici contano anche i blocchi nascosti,
// così coincidono con l'ordine del form: un clic qui apre il blocco giusto in /admin.
// .ed-ins = "＋" per aggiungere un blocco in quel punto (data-where "t0" o "" per la pagina, data-at = posizione).
import Blocco from "../../components/Blocco.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PrenotaEvento from "../../components/PrenotaEvento.astro";
import EventCard from "../../components/EventCard.astro";
import Sfondo from "../../components/Sfondo.astro";
import EventoHero from "../../components/EventoHero.astro";
import TimelineCard from "../../components/TimelineCard.astro";
import { isAdmin } from "../../lib/auth";
import { getEvents, getSettings } from "../../lib/db";
import { BLOCK_TEXT, bookCta, googleFontsHref, look, pageBg, SITE_FONTS_HREF, tabLooks } from "../../lib/format";
import { BLOCKS, bgObj, blockSchema, eventoSchema, type Block, type Evento } from "../../lib/schema";
import "../../styles/global.css";
import "../../styles/index.css";
import "../../styles/timeline.css";
import "../../styles/evento.css";

if (Astro.request.method !== "POST" || !(await isAdmin(Astro.cookies))) return new Response(null, { status: 401 });
const { slug, data, blocks, sfondo, cards: soloCard } = await Astro.request.json();
// campi obbligatori ancora vuoti: segnaposto, così l'anteprima si vede già mentre si scrive
const r = blocks
    ? blockSchema.array().safeParse(blocks)
    : eventoSchema.safeParse({ title: "Titolo dell'evento", theme: "Tema", duration: "—", excerpt: "Estratto dell'evento…", ...data });
const evento: Evento | undefined = r.success && !blocks ? { id: slug || "anteprima", data: r.data as Evento["data"] } : undefined;
const lista: Block[] = r.success && blocks ? (r.data as Block[]) : [];
const [s, eventi] = await Promise.all([getSettings(), getEvents()]);
const d = evento?.data;
const looks = d ? tabLooks(d) : [];
const fonts = googleFontsHref(
    d?.titleFont, d?.heroStyle?.font, ...looks.map((l) => l?.font),
    ...[...lista, ...(d?.tabs.flatMap((t) => t.blocks) ?? [])].map((b) => b.style?.font),
);
// sfondo come sul sito: quello della pagina o dell'evento, altrimenti quello del sito
const bodyBg = pageBg((d ? d.sfondo : bgObj.safeParse(sfondo).data) ?? s.sfondo);
// "＋" con la scelta del tipo di blocco; nelle schede niente sezioni fisse del sito. Testi: costanti di format.ts
const ins = (where: string, at: number, end = false) =>
    `<div class="ed-ins${end ? " end" : ""}" data-where="${where}" data-at="${at}"><span class="ed-plus" title="Aggiungi un blocco qui">＋</span><div class="ed-pal">` +
    BLOCKS.filter((t) => !(where && t === "sezione")).map((t) => `<button type="button" data-add="${t}" title="${BLOCK_TEXT[t][2]}">${BLOCK_TEXT[t][0]} ${BLOCK_TEXT[t][1]}</button>`).join("") +
    `</div></div>`;
// larghezze reali: colonna della timeline su computer e telefono, metà griglia della lista eventi
const cards = [
    ["Timeline · computer", "400px", TimelineCard],
    ["Timeline · telefono", "330px", TimelineCard],
    ["Lista eventi", "540px", EventCard],
] as const;
---

<!doctype html>
<html lang="it">
<head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href={SITE_FONTS_HREF} />
    {fonts && <link rel="stylesheet" href={fonts} />}
</head>
<body style={bodyBg && `--page-bg:${bodyBg}`}>
    {!soloCard && <Header />}
    <main>
        {evento && soloCard ? (
            <div class="prev-cards">
                {cards.map(([label, w, Card]) => (
                    <figure style={`width:${w}`}>
                        <figcaption>{label}</figcaption>
                        <Card evento={evento} />
                    </figure>
                ))}
            </div>
        ) : evento ? (
            <>
                <div class="ev-page" style={evento.data.titleFont && `--ev-font:${evento.data.titleFont}`}>
                    <div data-ed="hero"><EventoHero d={evento.data} cta={bookCta(evento.data, s)} /></div>
                    <div class="ev-tabs tabs-on">
                        <nav class="ev-tabbar" role="tablist">
                            {evento.data.tabs.map((t, i) => (
                                <a class="ev-tab" role="tab" data-ed={`t${i}`} aria-selected={i === 0 ? "true" : "false"}>{t.title}</a>
                            ))}
                            <button type="button" class="ed-tab-add" data-add="tab">＋ Scheda</button>
                        </nav>
                    {evento.data.tabs.map((t, i) => (
                        <section class:list={["ev-panel section", i === 0 && "on"]} {...look(looks[i])}>
                            <Sfondo bg={looks[i]} />
                            <div class="container ev-panel-inner">
                                <div data-ed={`t${i}`}>
                                    <h2 class="ev-panel-title">{t.title}</h2>
                                    <div class="divider"><span>⬥</span></div>
                                </div>
                                {t.blocks.map((b, j) => !b.hidden && (
                                    <>
                                        <Fragment set:html={ins(`t${i}`, j)} />
                                        <div class="ed" data-ed={`t${i}.${j}`}><Blocco b={b} eventi={eventi} evento={evento} inline edit /></div>
                                    </>
                                ))}
                                <Fragment set:html={ins(`t${i}`, t.blocks.length, true)} />
                            </div>
                        </section>
                    ))}
                    </div>
                </div>
                {!evento.data.noPrenota && <PrenotaEvento title={evento.data.title} cta={bookCta(evento.data, s)} />}
            </>
        ) : r.success ? (
            <>
                {lista.map((b, i) => !b.hidden && (
                    <>
                        <Fragment set:html={ins("", i)} />
                        <div data-ed={i}><Blocco b={b} eventi={eventi} edit /></div>
                    </>
                ))}
                <Fragment set:html={ins("", lista.length, true)} />
            </>
        ) : (
            <p class="prev-err">Da correggere per l'anteprima: {r.error?.issues.map((i) => i.path.join(".")).join(", ")}</p>
        )}
    </main>
    {!soloCard && <Footer />}
</body>
</html>

<style is:global>
    div[data-ed] { display: contents; }
    [data-ed] > *, a[data-ed] { cursor: pointer; }
    div[data-ed] > :hover, a[data-ed]:hover { outline: 2px dashed rgb(31 95 168 / 0.55); outline-offset: -2px; }
    div[data-ed].sel > *, a[data-ed].sel { outline: 3px solid #1f5fa8; outline-offset: -3px; }
    .ev-panel-inner > .ed ~ .ed > .blocco { margin-top: 3.5rem; } /* come .blocco + .blocco sul sito */
    /* "＋" tra i blocchi: un cerchietto; passandoci sopra si apre la scelta del tipo */
    .ed-ins { position: relative; z-index: 30; height: 0; font: 500 13px/1.2 system-ui, sans-serif; }
    .ed-plus {
        position: absolute; left: 50%; top: 0; transform: translate(-50%, -50%); display: grid; place-items: center;
        width: 28px; height: 28px; border-radius: 50%; background: #1f5fa8; color: #fff; font-size: 16px; opacity: 0.35; cursor: pointer;
    }
    .ed-ins:hover .ed-plus { opacity: 1; }
    .ed-pal {
        display: none; position: absolute; left: 50%; top: 14px; transform: translateX(-50%); width: max-content; max-width: 90vw;
        flex-wrap: wrap; justify-content: center; gap: 6px; padding: 10px; background: #fff; border: 1px solid #1f5fa8;
        border-radius: 8px; box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    }
    .ed-ins:hover .ed-pal { display: flex; }
    .ed-ins.end { height: auto; margin: 2.5rem 0 0; }
    .ed-ins.end .ed-plus { display: none; }
    .ed-ins.end .ed-pal { display: flex; position: static; transform: none; width: auto; max-width: none; box-shadow: none; border-style: dashed; }
    .ed-ins.end .ed-pal::before { content: "Aggiungi qui:"; align-self: center; color: #555; }
    .ed-pal button, .ed-tab-add {
        font: inherit; padding: 6px 10px; border: 1px solid rgb(0 0 0 / 0.2); border-radius: 6px; background: #fff; color: #1a1a1a; cursor: pointer;
    }
    .ed-pal button:hover, .ed-tab-add:hover { border-color: #1f5fa8; color: #1f5fa8; }
    .ed-tab-add { font: 500 13px/1.2 system-ui, sans-serif; align-self: center; }
    main > .ed-ins.end { margin: 0; padding: 2rem; }
    /* modifica diretta: testi scrivibili, segnaposto, foto in caricamento */
    [contenteditable]:not([contenteditable="false"]) { cursor: text; outline-offset: 4px; }
    [contenteditable]:not([contenteditable="false"]):hover { outline: 1px dashed rgb(31 95 168 / 0.6); }
    [contenteditable]:not([contenteditable="false"]):focus { outline: 2px solid #1f5fa8; background: rgb(255 255 255 / 0.35); }
    [data-ph]:empty::before { content: attr(data-ph); opacity: 0.45; font-style: italic; }
    div[data-ed]:not(.sel) .ed-ph { display: none; }
    img.ed-up { opacity: 0.4; }
    /* "＋ Foto/Personaggio/Domanda/Data" dentro il blocco e ✕ dei testi facoltativi: solo al passaggio del mouse o a blocco scelto */
    .ed-add { display: flex; justify-content: center; margin-top: 1rem; visibility: hidden; font: 500 13px/1.2 system-ui, sans-serif; }
    .ed-add button, .ed-x { font: inherit; border: 1px solid rgb(31 95 168 / 0.5); background: #fff; color: #1f5fa8; cursor: pointer; }
    .ed-add button { padding: 6px 12px; border-style: dashed; border-radius: 6px; }
    .ed-add button:hover, .ed-x:hover { background: #1f5fa8; color: #fff; }
    div[data-ed]:hover .ed-add, div[data-ed].sel .ed-add { visibility: visible; }
    .ed-x { position: absolute; top: -12px; left: 0; z-index: 30; display: none; padding: 1px 6px; border-radius: 50%; font-size: 12px; }
    .ed-x:hover, [data-field]:hover + .ed-x { display: block; }
    [data-field]:empty + .ed-x { display: none !important; }
    .blocco-head [data-field] { display: inline-block; }
    .blocco-head .ed-x { position: static; vertical-align: top; margin-left: 4px; }
    .blocco-head .ed-x:hover, .blocco-head [data-field]:hover + .ed-x { display: inline-block; }
    .ed-xtab { position: static; margin-left: 12px; border-radius: 6px; padding: 4px 10px; vertical-align: middle; }
    div[data-ed]:hover .ed-xtab, div[data-ed].sel .ed-xtab { display: inline-block; }
    /* strumenti nell'angolo in alto a destra di blocchi e sezioni */
    .ed-tools {
        position: absolute; top: 8px; right: 8px; z-index: 40; display: none; gap: 4px; align-items: center;
        padding: 4px; background: #fff; border: 1px solid #1f5fa8; border-radius: 8px; box-shadow: 0 4px 14px rgb(0 0 0 / 0.18);
        font: 500 13px/1.2 system-ui, sans-serif; color: #1a1a1a; text-align: left; letter-spacing: 0; text-transform: none;
    }
    :is(div[data-ed]:hover > *, div[data-ed].sel > *, [data-sez]:hover, .site-header:hover, .site-footer:hover) > .ed-tools { display: flex; }
    .ed-tools button { font: inherit; min-width: 28px; padding: 5px 8px; border: 1px solid rgb(0 0 0 / 0.15); border-radius: 5px; background: #fff; color: inherit; cursor: pointer; }
    .ed-tools button:hover { border-color: #1f5fa8; color: #1f5fa8; }
    .ed-tools .ed-ins { position: relative; height: auto; }
    .ed-tools .ed-plus { position: static; transform: none; opacity: 1; }
    .ed-tools .ed-pal { left: auto; right: 0; top: 100%; transform: none; }
    .site-header .ed-tools { top: 50%; transform: translateY(-50%); }
    :is([data-sez], .site-footer) > .ed-tools { top: auto; bottom: 12px; } /* in alto finirebbero sotto l'header fisso */
    /* maniglia in basso: si trascina per l'altezza della sezione */
    .ed-grip { position: absolute; left: 0; right: 0; bottom: 0; z-index: 35; height: 10px; cursor: ns-resize; }
    .ed-grip:hover, .ed-grip[data-h] { background: rgb(31 95 168 / 0.35); }
    .ed-grip[data-h]::after {
        content: attr(data-h); position: absolute; right: 12px; bottom: 14px; padding: 4px 8px; border-radius: 4px;
        background: #1f5fa8; color: #fff; font: 600 12px system-ui, sans-serif;
    }
</style>

<style>
    .prev-cards {
        display: flex;
        flex-wrap: wrap;
        align-items: start;
        gap: 2.5rem;
        padding: 2.5rem 2rem 3rem;
    }
    figcaption,
    .prev-err {
        font: 600 0.8rem/1.4 system-ui, sans-serif;
        color: var(--cream-dim);
        margin-bottom: 0.5rem;
    }
    .prev-err {
        padding: 2rem;
        font-size: 1rem;
    }
</style>
