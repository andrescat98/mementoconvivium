---
import Layout from "../layouts/Layout.astro";
import { getSettings } from "../lib/db";

const s = await getSettings();
const handle = s.instagram?.replace(/\/+$/, "").split("/").pop();
import "../styles/index.css";
---

<Layout
    title="Contatti — Memento Convivium"
    description="Scrivici o chiamaci per prenotare il tuo posto al banchetto: email, telefono e WhatsApp di Memento Convivium."
>
    <section class="section contatti">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Parla con noi</span>
                <h2>Contatti</h2>
                <div class="divider"><span>⬥</span></div>
                <p class="contatti-sub">
                    Per prenotazioni, informazioni o eventi privati.<br />
                    Rispondiamo volentieri.
                </p>
            </div>

            <div class="contatti-grid">
                {s.phone && (
                    <a class="contatti-card" href={"tel:" + s.phone.replace(/[^\d+]/g, "")}>
                        <span class="contatti-icon">☎</span>
                        <span class="contatti-label">Chiama</span>
                        <span class="contatti-value">{s.phone}</span>
                    </a>
                )}
                {s.whatsapp && (
                    <a class="contatti-card" href={"https://wa.me/" + s.whatsapp} target="_blank" rel="noopener noreferrer">
                        <span class="contatti-icon">✆</span>
                        <span class="contatti-label">WhatsApp</span>
                        <span class="contatti-value">+{s.whatsapp}</span>
                    </a>
                )}
                <a class="contatti-card" href={"mailto:" + s.email}>
                    <span class="contatti-icon">✉</span>
                    <span class="contatti-label">Email</span>
                    <span class="contatti-value">{s.email}</span>
                </a>
                {s.instagram && (
                    <a class="contatti-card" href={s.instagram} target="_blank" rel="noopener noreferrer">
                        <span class="contatti-icon">◎</span>
                        <span class="contatti-label">Instagram</span>
                        <span class="contatti-value">@{handle}</span>
                    </a>
                )}
            </div>
        </div>
    </section>
</Layout>

<style>
    .contatti {
        padding-top: 9rem;
    }

    .contatti-sub {
        color: var(--cream-dim);
        font-size: 1rem;
        line-height: 1.8;
        margin-top: 0.5rem;
    }

    .contatti-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        max-width: 760px;
        margin: 0 auto;
    }

    .contatti-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2.5rem 1.5rem;
        text-align: center;
        text-decoration: none;
        background: var(--bg-card);
        border: 1px solid var(--border);
        transition:
            transform 0.4s var(--ease-out),
            box-shadow 0.4s var(--ease-out),
            border-color 0.4s;
    }

    .contatti-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 40px -20px var(--gold-glow-strong);
        border-color: var(--gold-dim);
    }

    .contatti-icon {
        font-size: 1.8rem;
        color: var(--gold);
        line-height: 1;
    }

    .contatti-label {
        font-family: var(--font-title);
        font-size: 0.62rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold-dim);
    }

    .contatti-value {
        font-size: 1.05rem;
        color: var(--cream);
    }
</style>
