---
import Layout from "../layouts/Layout.astro";
import Contatti from "../components/Contatti.astro";
import { getSettings } from "../lib/db";
import "../styles/index.css";

const s = await getSettings();
---

<Layout
    title="Contatti — Memento Convivium"
    description="Scrivici o chiamaci per prenotare il tuo posto al banchetto: email, telefono e WhatsApp di Memento Convivium."
    sfondo={s.sfondoPagine["contatti"]}
>
    <Contatti s={s} />
</Layout>
