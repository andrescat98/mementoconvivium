---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";

const eventi = await getCollection("eventi");

const oggi = new Date().toISOString().slice(0, 10);
const prossimo =
    eventi.find((e) => e.data.dates?.some((d) => d.dateISO >= oggi)) ??
    eventi.find((e) => e.data.featured) ??
    eventi[0];

const statusLabel: Record<string, string> = {
    aperto: "Prenota ora",
    "lista-attesa": "Lista d'attesa",
    "coming-soon": "Coming soon",
    chiuso: "Prenotazioni chiuse",
};
---

<Layout
    title="Lista eventi — Memento Convivium"
    description="Tutti gli spettacoli di Memento Convivium: cene con delitto a tema storico dall'antico Egitto al proibizionismo."
>
    <!-- PAGE HERO -->
    <section class="page-hero">
        <div class="page-hero-vignette" aria-hidden="true"></div>
        <div class="page-hero-content">
            <a href="/" class="page-hero-back">← Torna alla home</a>
            <span class="section-label">Prossimi appuntamenti</span>
            <h1>Gli spettacoli</h1>
            <div class="divider"><span>⬥</span></div>
            <p class="page-hero-sub">
                Ogni serata è un viaggio in un'epoca diversa.<br />
                Scegli il tuo banchetto e prenota il tuo posto.
            </p>
        </div>
    </section>

    <!-- GRIGLIA EVENTI -->
    <section class="section eventi" id="eventi">
        <div class="container">
            <div class="events-grid">
                {
                    eventi.map((evento) => {
                        const isProssimo = evento.id === prossimo.id;
                        const label =
                            statusLabel[evento.data.status] ?? "Scopri di più";
                        const btnClass =
                            evento.data.status === "aperto"
                                ? "btn-primary"
                                : "btn-ghost";
                        return (
                            <article
                                class={`event-card${isProssimo ? " featured" : ""}`}
                            >
                                {isProssimo && (
                                    <div class="event-tag">Prossimo</div>
                                )}
                                <div class="event-theme">
                                    {evento.data.theme}
                                </div>
                                <h3 class="event-title">{evento.data.title}</h3>
                                <p class="event-desc">{evento.data.excerpt}</p>
                                <div class="event-meta">
                                    <div class="event-info">
                                        <span class="meta-label">Data</span>
                                        <span>~
                                            {evento.data.dates?.find((d) => d.dateISO >= oggi)?.label ?? evento.data.dates?.[0]?.label ?? "Da annunciare"}
                                        </span>
                                    </div>
                                    <div class="event-info">
                                        <span class="meta-label">Ospiti</span>
                                        <span>{evento.data.guests}</span>
                                    </div>
                                    <div class="event-info">
                                        <span class="meta-label">Durata</span>
                                        <span>{evento.data.duration}</span>
                                    </div>
                                </div>
                                <div class="event-card-actions">
                                    <a
                                        href={`/eventi/${evento.id}`}
                                        class={btnClass}
                                    >
                                        {label}
                                    </a>
                                    <a
                                        href={`/eventi/${evento.id}`}
                                        class="event-detail-link"
                                    >
                                        Scopri la storia →
                                    </a>
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- CTA PRENOTA -->
    <section class="section prenota" id="prenota">
        <div class="container">
            <div class="prenota-inner">
                <div class="prenota-ornament">
                    <span>✦</span>
                    <div class="orn-line"></div>
                    <span>✦</span>
                </div>
                <span class="section-label">Partecipa</span>
                <h2>Sei pronto a sederti al banchetto?</h2>
                <p>
                    Scrivi per prenotare il tuo posto o richiedere informazioni.<br
                    />
                    Ogni evento è a numero chiuso.
                </p>
                <a
                    href="mailto:info@mementoconvivium.it"
                    class="btn-primary btn-large"
                >
                    Contattaci
                </a>
                <p class="prenota-note">
                    Oppure scrivici su <a href="https://instagram.com"
                        >Instagram</a
                    >
                </p>
                <div class="prenota-ornament">
                    <span>✦</span>
                    <div class="orn-line"></div>
                    <span>✦</span>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* ── Page Hero ──────────────────────────────────── */
    .page-hero {
        position: relative;
        padding: 10rem 2rem 5rem;
        text-align: center;
        overflow: hidden;
    }

    .page-hero-vignette {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            var(--bg) 0%,
            transparent 40%,
            var(--bg) 100%
        );
        pointer-events: none;
    }

    .page-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }

    .page-hero-back {
        font-family: var(--font-title);
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold-dim);
        text-decoration: none;
        margin-bottom: 0.5rem;
        transition: color 0.3s;
        align-self: flex-start;
        position: absolute;
        top: -4rem;
        left: 0;
    }

    .page-hero-back:hover {
        color: var(--gold);
    }

    .page-hero-content h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        color: var(--cream);
        line-height: 1.1;
    }

    .page-hero-sub {
        color: var(--cream-dim);
        font-size: 1rem;
        line-height: 1.8;
        max-width: 480px;
        margin-top: 0.5rem;
    }

    /* eventi section: no top border/bg on this page, the hero already separates */
    .eventi {
        border-top: 1px solid var(--border);
        background: var(--bg-card);
        padding-top: 3rem;
    }

    @media (max-width: 768px) {
        .page-hero {
            padding: 8rem 1.5rem 3rem;
        }

        .page-hero-back {
            top: -3rem;
        }
    }
</style>
