---
import Layout from "../layouts/Layout.astro";
import ListaEventi from "../components/ListaEventi.astro";
import { getEvents, getSettings } from "../lib/db";
import "../styles/index.css";

const [eventi, s] = await Promise.all([getEvents(), getSettings()]);
---

<Layout
    title="Lista eventi — Memento Convivium"
    description="Tutti gli spettacoli di Memento Convivium: cene con delitto a tema storico dall'antico Egitto al proibizionismo."
    sfondo={s.sfondoPagine["lista-eventi"]}
>
    <ListaEventi eventi={eventi} s={s} />
</Layout>
