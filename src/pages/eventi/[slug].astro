---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    // Le cene coming-soon non hanno una pagina dedicata
    const eventi = (await getCollection("eventi")).filter(
        (e: CollectionEntry<"eventi">) => e.data.status !== "coming-soon",
    );
    return eventi.map((evento: CollectionEntry<"eventi">) => ({
        params: { slug: evento.id },
        props: { evento },
    }));
}

interface Props {
    evento: CollectionEntry<"eventi">;
}

const { evento } = Astro.props as Props;
const { Content } = await render(evento);
const {
    title,
    theme,
    dates,
    duration,
    location,
    price,
    includes,
    characters,
    status,
    characterFont,
} = evento.data;

const today = new Date();
today.setHours(0, 0, 0, 0);

const nextDate = dates?.find(
    (d: { dateISO: string }) => new Date(d.dateISO) >= today,
);

const displayDate = nextDate?.label ?? dates?.[0]?.label ?? "Da annunciare";
const displayDateISO = nextDate?.dateISO ?? null;

const statusLabel =
    status === "aperto"
        ? "Prenota ora"
        : status === "lista-attesa"
          ? "Lista d'attesa"
          : status === "chiuso"
            ? "Prenotazioni chiuse"
            : "Coming soon";

const statusClass = status === "aperto" ? "btn-primary" : "btn-ghost";

---

<Layout
    title={`${title} · Memento Convivium`}
    description={evento.data.excerpt}
>
    <!-- HERO EVENTO -->
    <section class="ev-hero">
        <div class="ev-hero-vignette" aria-hidden="true"></div>
        <div class="container ev-hero-inner">
            <a href="/#eventi" class="ev-back">
                <span>←</span> Tutti gli eventi
            </a>
            <div class="ev-hero-content">
                <span class="section-label">{theme}</span>
                <h1 class="ev-title">{title}</h1>
                <div class="ev-meta-row">
                    <div class="ev-meta-item">
                        <span class="meta-label">Data</span>
                        <span>{displayDate}</span>
                    </div>
                    <div class="ev-meta-divider">⬥</div>
                    <div class="ev-meta-item">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="greek-border"></div>
    </section>

    <!-- CORPO NARRATIVO -->
    <section class="section ev-body">
        <div class="container ev-grid">
            <!-- Colonna sinistra: testo -->
            <div class="ev-text">
                <span class="section-label">La storia</span>
                <div class="ev-prose">
                    <Content />
                </div>
            </div>

            <!-- Colonna destra: info box -->
            <aside class="ev-sidebar">
                <!-- Info pratiche -->
                <div class="ev-infobox">
                    <h3 class="ev-infobox-title">Dettagli</h3>
                    <div class="divider"><span>⬥</span></div>

                    {dates && dates.length > 0 ? (
                        <div class="ev-date-boxes">
                            {dates.map((d: { label: string; dateISO: string; location?: string; price?: string }) => {
                                const isPast = new Date(d.dateISO) < today;
                                return (
                                    <div class={`ev-date-box${isPast ? " ev-date-box-past" : ""}`}>
                                        <div class="ev-date-box-label">{d.label}</div>
                                        {d.location && <div class="ev-date-box-info"><span class="meta-label">Luogo</span>{d.location}</div>}
                                        {d.price && <div class="ev-date-box-info"><span class="meta-label">Quota</span>{d.price}</div>}
                                    </div>
                                );
                            })}
                        </div>
                    ) : (
                        <>
                            <div class="ev-info-row">
                                <span class="meta-label">Data</span>
                                <span>Da annunciare</span>
                            </div>
                            {location && (
                                <div class="ev-info-row">
                                    <span class="meta-label">Luogo</span>
                                    <span>{location}</span>
                                </div>
                            )}
                            {price && (
                                <div class="ev-info-row">
                                    <span class="meta-label">Quota</span>
                                    <span>{price}</span>
                                </div>
                            )}
                        </>
                    )}
                    <div class="ev-info-row">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>

                    {
                        includes && includes.length > 0 && (
                            <div class="ev-includes">
                                <span
                                    class="meta-label"
                                    style="display:block; margin-bottom:.75rem;"
                                >
                                    Include
                                </span>
                                <ul class="ev-includes-list">
                                    {includes.map((item: string) => (
                                        <li>
                                            <span class="ev-check">⬥</span>
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )
                    }

                    <a
                        id="ev-prenota-btn"
                        href="mailto:info@mementoconvivium.it"
                        class={`${statusClass} ev-cta-btn`}
                    >
                        {statusLabel}
                    </a>
                    <p class="ev-cta-note">
                        Oppure scrivici su <a href="https://www.instagram.com/memento_convivium"
                            >Instagram</a
                        >
                    </p>
                </div>
            </aside>
        </div>
    </section>

    <!-- PERSONAGGI -->
    {
        characters && characters.length > 0 && (
            <section class="section ev-characters">
                <div class="container">
                    <div class="section-header">
                        <span class="section-label">I protagonisti</span>
                        <h2>I personaggi della serata</h2>
                        <div class="divider">
                            <span>⬥</span>
                        </div>
                        <p class="ev-characters-sub">
                            Ogni ospite riceverà la propria scheda via email.
                            <br />
                            Questi sono i volti che troverai al banchetto.
                        </p>
                    </div>
                    <div class="ev-chars-grid">
                        {characters.map(
                            (c: {
                                name: string;
                                role: string;
                                hint: string;
                                portrait?: string;
                            }) => (
                                <div class="ev-char-card">
                                    <button
                                        type="button"
                                        class={`ev-char-avatar${c.portrait ? " has-portrait" : ""}`}
                                        data-portrait={
                                            c.portrait
                                                ? `/eventi/${evento.id}/${c.portrait}`
                                                : undefined
                                        }
                                        data-name={c.name}
                                    >
                                        {c.portrait && (
                                            <img
                                                class="ev-char-portrait"
                                                src={`/eventi/${evento.id}/${c.portrait}`}
                                                alt={c.name}
                                                loading="lazy"
                                            />
                                        )}
                                        <span class="ev-char-initial">
                                            {c.name.charAt(0)}
                                        </span>
                                    </button>
                                    <h4 class="ev-char-name">{c.name}</h4>
                                    <p class="ev-char-role">{c.role}</p>
                                    <div class="divider">
                                        <span>⬥</span>
                                    </div>
                                    <p class="ev-char-hint">"{c.hint}"</p>
                                </div>
                            ),
                        )}
                    </div>
                </div>
            </section>
        )
    }

    <!-- CTA FINALE -->
    <section class="section ev-final-cta">
        <div class="container">
            <div class="prenota-inner">
                <div class="prenota-ornament">
                    <span>✦</span>
                </div>
                <span class="section-label">Partecipa</span>
                <h2>Sei pronto a sederti al banchetto?</h2>
                <p>
                    Riserva il tuo posto al tavolo: scrivici e ti racconteremo
                    come unirti alla prossima serata. Ogni evento è a numero
                    chiuso e i posti vanno in fretta.
                </p>
                <a
                    href="mailto:info@mementoconvivium.it"
                    class={`${statusClass} btn-large`}
                >
                    {statusLabel}
                </a>
                <p class="prenota-note">
                    Oppure scrivici su <a href="https://www.instagram.com/memento_convivium"
                        >Instagram</a
                    >
                </p>

                <div class="prenota-locale">
                    <p class="prenota-locale-text">
                        Sei un locale, un ristorante o un'associazione?
                    </p>
                    <a
                        href="mailto:info@mementoconvivium.it?subject=Portare%20questa%20cena%20con%20delitto%20nel%20mio%20locale"
                        class="btn-ghost"
                    >
                        Porta questa cena con delitto da te →
                    </a>
                </div>
                <div class="prenota-ornament">
                    <span>✦</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FULLSCREEN RITRATTO -->
    <dialog
        id="ev-photo-dialog"
        class="ev-photo-dialog"
        style={`--char-font: ${characterFont ?? "var(--font-title)"}`}
    >
        <button type="button" class="ev-photo-close" aria-label="Chiudi">✕</button>
        <div class="ev-photo-card" id="ev-photo-card">
            <img id="ev-photo-dialog-img" alt="" />
        </div>
        <p id="ev-photo-dialog-name" class="ev-photo-name"></p>
    </dialog>
</Layout>

<script define:vars={{ displayDateISO }}>
    // Nascondi il bottone prenota se non ci sono date future disponibili
    if (displayDateISO) {
        const eventDate = new Date(displayDateISO);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (eventDate < today) {
            const btn = document.getElementById("ev-prenota-btn");
            if (btn) btn.style.display = "none";
        }
    }
</script>

<script>
    /* ── TUNING RITRATTO FULLSCREEN (desktop) ─────────────────────
       ZOOM_DEFAULT  zoom iniziale all'apertura (1 = dimensione piena)
       ZOOM_MIN/MAX  limiti della rotella
       ZOOM_STEP     incremento per scatto di rotella
       TILT_DEG      inclinazione max della card in gradi (± metà per lato)
       Dimensione "piena" della foto: vedi CSS .ev-photo-card img
       (max-width / max-height) e la media query touch più sotto. */
    const ZOOM_DEFAULT = 1.2;
    const ZOOM_MIN = 0.8;
    const ZOOM_MAX = 2;
    const ZOOM_STEP = 0.1;
    const TILT_DEG = 18;

    // Ritratto a schermo intero: apre il <dialog> nativo col src cliccato
    const photoDialogEl = document.getElementById("ev-photo-dialog");
    const photoDialog =
        photoDialogEl instanceof HTMLDialogElement ? photoDialogEl : null;
    const photoDialogImg = document.getElementById("ev-photo-dialog-img");
    const photoDialogName = document.getElementById("ev-photo-dialog-name");
    const photoCard = document.getElementById("ev-photo-card");

    const isDesktop = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
    ).matches;

    // Su desktop la card parte al 50% e si zooma con la rotella; su touch resta full
    let zoom = 1;
    const applyZoom = () => {
        if (photoDialogImg instanceof HTMLImageElement) {
            // dimensione "piena" (zoom=1): tenere uguale a .ev-photo-card img nel CSS
            photoDialogImg.style.maxWidth = `calc(min(80vw, 480px) * ${zoom})`;
            photoDialogImg.style.maxHeight = `calc(72vh * ${zoom})`;
        }
    };

    document.addEventListener("click", (e) => {
        const avatar =
            e.target instanceof Element
                ? e.target.closest<HTMLElement>(".ev-char-avatar[data-portrait]")
                : null;
        if (avatar && photoDialog && photoDialogImg instanceof HTMLImageElement) {
            photoDialogImg.src = avatar.dataset.portrait ?? "";
            photoDialogImg.alt = avatar.dataset.name ?? "";
            if (photoDialogName) photoDialogName.textContent = avatar.dataset.name ?? "";
            if (isDesktop) {
                zoom = ZOOM_DEFAULT;
                applyZoom();
            } else {
                requestGyroPermission();
            }
            photoDialog.showModal();
        }
    });

    photoDialog?.addEventListener("click", (e) => {
        if (e.target === photoDialog) photoDialog.close();
    });
    photoDialog
        ?.querySelector(".ev-photo-close")
        ?.addEventListener("click", () => photoDialog.close());

    // Effetto card semi-3D: il mouse è tracciato su tutto lo schermo, non solo sulla card
    if (photoCard && photoDialog && isDesktop) {
        photoDialog.addEventListener("mousemove", (e) => {
            const x = e.clientX / window.innerWidth - 0.5;
            const y = e.clientY / window.innerHeight - 0.5;
            photoCard.style.transform = `perspective(900px) rotateY(${x * TILT_DEG}deg) rotateX(${-y * TILT_DEG}deg)`;
        });
        photoDialog.addEventListener("mouseleave", () => {
            photoCard.style.transform = "";
        });

        // Rotella: zoom della card con limiti
        photoDialog.addEventListener(
            "wheel",
            (e) => {
                e.preventDefault();
                zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, zoom - Math.sign(e.deltaY) * ZOOM_STEP));
                applyZoom();
            },
            { passive: false },
        );
    }

    // Su mobile: tilt della card via giroscopio (deviceorientation)
    if (photoCard && !isDesktop) {
        let gyroBound = false;
        const onOrientation = (e: DeviceOrientationEvent) => {
            const x = Math.max(-45, Math.min(45, e.gamma ?? 0)) / 45;
            const y = Math.max(-45, Math.min(45, (e.beta ?? 0) - 45)) / 45;
            photoCard.style.transform = `perspective(900px) rotateY(${x * TILT_DEG}deg) rotateX(${-y * TILT_DEG}deg)`;
        };
        var requestGyroPermission = () => {
            if (gyroBound) return;
            const DOE = DeviceOrientationEvent as unknown as {
                requestPermission?: () => Promise<"granted" | "denied">;
            };
            if (typeof DOE.requestPermission === "function") {
                DOE.requestPermission()
                    .then((state) => {
                        if (state === "granted") {
                            gyroBound = true;
                            window.addEventListener("deviceorientation", onOrientation);
                        }
                    })
                    .catch(() => {});
            } else {
                gyroBound = true;
                window.addEventListener("deviceorientation", onOrientation);
            }
        };
        photoDialog?.addEventListener("close", () => photoCard && (photoCard.style.transform = ""));
    } else {
        var requestGyroPermission = () => {};
    }
</script>

<style>
    /* ── Hero evento ── */
    .ev-hero {
        padding-top: 8rem;
        padding-bottom: 4rem;
        background: var(--bg-2);
        border-bottom: 1px solid var(--border);
        position: relative;
    }

    .ev-hero-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 60% 0%,
            rgba(0, 0, 0, 0.04) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .ev-hero-inner {
        position: relative;
        z-index: 1;
    }

    .ev-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-title);
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold-dim);
        text-decoration: none;
        margin-bottom: 2.5rem;
        transition: color 0.3s;
    }

    .ev-back:hover {
        color: var(--gold);
    }

    .ev-hero-content {
        max-width: 700px;
    }

    .ev-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3.8rem);
        font-weight: 400;
        color: var(--white);
        line-height: 1.1;
        margin: 0.75rem 0 1.5rem;
    }

    .ev-badge {
        display: inline-block;
        font-family: var(--font-title);
        font-size: 0.6rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--bg);
        background: var(--gold);
        padding: 0.25rem 0.75rem;
        margin-bottom: 1rem;
    }

    .ev-meta-row {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .ev-meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-size: 0.95rem;
    }

    .ev-meta-divider {
        color: var(--gold-dim);
        font-size: 0.5rem;
        opacity: 0.5;
    }

    /* ── Body narrativo ── */
    .ev-body {
        background: var(--bg-card);
        border-top: 1px solid var(--border);
    }

    /* ── Body grid ── */
    .ev-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 4rem;
        align-items: start;
    }

    /* ── Testo narrativo ── */
    .ev-text .section-label {
        margin-bottom: 1.5rem;
    }

    .ev-prose {
        font-size: 1.1rem;
        line-height: 1.85;
        color: var(--cream);
    }

    .ev-prose p {
        margin-bottom: 1.4rem;
    }

    .ev-prose strong {
        color: var(--white);
        font-weight: 600;
    }

    .ev-prose em {
        color: var(--cream-dim);
        font-style: italic;
    }

    /* ── Sidebar infobox ── */
    .ev-infobox {
        border: 1px solid var(--border);
        background: var(--bg-card);
        padding: 2rem;
        position: sticky;
        top: 6rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .ev-infobox-title {
        font-size: 1rem;
        color: var(--white);
        letter-spacing: 0.1em;
    }

    .ev-info-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--border);
    }

    .ev-info-row:last-of-type {
        border-bottom: none;
    }

    .ev-includes {
        padding-top: 0.5rem;
    }

    .ev-includes-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.88rem;
        color: var(--cream-dim);
    }

    .ev-includes-list li {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
    }

    .ev-check {
        color: var(--gold);
        font-size: 0.45rem;
        flex-shrink: 0;
        position: relative;
        top: -1px;
    }

    /* ── Box date ── */
    .ev-date-boxes {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.2rem 0 0.6rem;
        border-bottom: 1px solid var(--border);
    }

    .ev-date-box {
        border: 1px solid var(--border);
        padding: 0.75rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .ev-date-box-past {
        opacity: 0.4;
    }

    .ev-date-box-label {
        font-size: 0.95rem;
        color: var(--white);
        font-weight: 500;
    }

    .ev-date-box-past .ev-date-box-label {
        text-decoration: line-through;
        text-decoration-color: rgba(255,255,255,0.2);
    }

    .ev-date-box-info {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        font-size: 0.82rem;
        color: var(--cream-dim);
    }

    .ev-date-box-info .meta-label {
        flex-shrink: 0;
    }

    .ev-cta-btn {
        display: block;
        text-align: center;
        margin-top: 0.5rem;
    }

    .ev-cta-note {
        font-size: 0.8rem;
        color: var(--gold-dim);
        text-align: center;
    }

    .ev-cta-note a {
        color: var(--gold);
        text-decoration: none;
    }

    .ev-cta-note a:hover {
        text-decoration: underline;
    }

    /* ── Personaggi ── */
    .ev-characters {
        background: var(--bg-2);
        border-top: 1px solid var(--border);
    }

    .ev-characters-sub {
        color: var(--cream-dim);
        font-size: 1rem;
        line-height: 1.7;
        margin-top: 0.5rem;
    }

    /* flex + centratura: l'ultima riga si centra, mai celle vuote */
    .ev-chars-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 1rem;
    }

    .ev-char-card {
        flex: 0 1 260px;
        min-width: 220px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.5rem;
        transition: background 0.3s;
    }

    .ev-char-card:hover {
        background: var(--bg-2);
    }

    .ev-char-avatar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        margin: 0 0 0.5rem;
        padding: 0;
        border: none;
        background: none;
        cursor: default;
        font: inherit;
    }

    .ev-char-avatar.has-portrait {
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .ev-char-avatar.has-portrait:hover,
    .ev-char-avatar.has-portrait:focus-visible {
        transform: scale(1.08);
        outline: none;
    }

    .ev-char-avatar.has-portrait::after {
        content: "";
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.5);
        font-size: 1.1rem;
        opacity: 0;
        transition: opacity 0.2s ease;
        pointer-events: none;
    }

    .ev-char-avatar.has-portrait:hover::after,
    .ev-char-avatar.has-portrait:focus-visible::after {
        opacity: 1;
    }

    .ev-char-initial {
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--gold);
        opacity: 0.45;
        line-height: 1;
    }

    .ev-char-avatar.has-portrait .ev-char-initial {
        position: absolute;
        right: -2px;
        bottom: -2px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        font-size: 0.8rem;
        opacity: 1;
        color: var(--bg);
        background: var(--gold);
        border: 1px solid var(--bg-card);
        border-radius: 50%;
    }

    .ev-char-portrait {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: 50%;
        border: 1px solid var(--border);
    }

    /* il dialog copre tutto lo schermo: è l'area attiva per il tilt e il click-fuori chiude */
    .ev-photo-dialog {
        margin: 0;
        width: 100vw;
        height: 100vh;
        max-width: 100vw;
        max-height: 100vh;
        border: none;
        background: transparent;
        padding: 0;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }

    .ev-photo-dialog[open] {
        display: flex;
    }

    .ev-photo-dialog::backdrop {
        background: rgba(0, 0, 0, 0.85);
    }

    /* la rotazione 3D del ritratto sporge dal viewport: niente scrollbar orizzontale mentre è aperto */
