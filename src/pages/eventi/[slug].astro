---
import Layout from "../../layouts/Layout.astro";
import EventoHero from "../../components/EventoHero.astro";
import Prenota from "../../components/Prenota.astro";
import Sfondo from "../../components/Sfondo.astro";
import { isAdmin } from "../../lib/auth";
import { getEvent, getSettings } from "../../lib/db";
import { bookCta, googleFontsHref, imgStyle, look, md, slugify } from "../../lib/format";
import "../../styles/evento.css";

const evento = await getEvent(Astro.params.slug!);
// Bozze e coming-soon non hanno una pagina pubblica: solo anteprima per i moderatori, mai in cache
if (!evento) {
    Astro.cache.set(false);
    return new Response(null, { status: 404 });
}
const hidden = evento.data.status === "bozza" || evento.data.status === "coming-soon";
const preview = hidden && (await isAdmin(Astro.cookies));
if (hidden) Astro.cache.set(false);
if (hidden && !preview) return new Response(null, { status: 404 });

const s = await getSettings();
const { title, excerpt, status, cover, background, tabs, titleFont, characterFont } = evento.data;
const cta = bookCta(evento.data, s);

// stile della scheda: campo per campo sopra quello predefinito
const looks = tabs.map((t) => (background || t.background ? { ...background, ...t.background } : undefined));

// ancore uniche per scheda (#la-storia, #personaggi…)
const seen = new Set<string>();
const ids = tabs.map((t, i) => {
    let id = slugify(t.title) || `scheda-${i + 1}`;
    if (seen.has(id)) id += `-${i + 1}`;
    seen.add(id);
    return id;
});
---

<Layout
    title={`${title} · Memento Convivium`}
    description={excerpt}
    fontHref={googleFontsHref(titleFont, characterFont)}
    image={cover?.src}
>
    {preview && (
        <p class="ev-preview-banner">
            Anteprima moderatori · stato "{status}": questa pagina non è visibile al pubblico
        </p>
    )}
    <div class="ev-page" style={titleFont && `--ev-font:${titleFont}`}>
        <EventoHero d={evento.data} cta={cta} />

        {tabs.length > 0 && (
            <div class="ev-tabs" data-tabs>
                {tabs.length > 1 && (
                    <nav class="ev-tabbar" role="tablist" aria-label="Sezioni dell'evento">
                        {tabs.map((t, i) => (
                            <a href={`#${ids[i]}`} role="tab" class="ev-tab" aria-controls={ids[i]} aria-selected={i === 0 ? "true" : "false"}>{t.title}</a>
                        ))}
                    </nav>
                )}
                {tabs.map((t, i) => (
                    <section id={ids[i]} class={`ev-panel section${i === 0 ? " on" : ""}`} role="tabpanel" {...look(looks[i])}>
                        <Sfondo bg={looks[i]} />
                        <div class="container ev-panel-inner">
                            <h2 class="ev-panel-title">{t.title}</h2>
                            <div class="divider"><span>⬥</span></div>
                            {t.template === "testo" ? (
                                <div class={t.image ? "ev-panel-grid" : "ev-panel-text"}>
                                    <div class="ev-prose" set:html={md(t.body ?? "")} />
                                    {t.image && (
                                        <button type="button" class="ev-figure crop" data-portrait={t.image.src} data-name="">
                                            <img src={t.image.src} alt="" loading="lazy" style={imgStyle(t.image)} />
                                        </button>
                                    )}
                                </div>
                            ) : (
                                <>
                                    {t.body && <div class="ev-prose ev-panel-intro" set:html={md(t.body)} />}
                                    {t.template === "galleria" ? (
                                        <div class="ev-gallery">
                                            {t.gallery?.map((g) => (
                                                <figure>
                                                    <button type="button" class="crop" data-portrait={g.image.src} data-name={g.caption ?? ""}>
                                                        <img src={g.image.src} alt={g.caption ?? ""} loading="lazy" style={imgStyle(g.image)} />
                                                    </button>
                                                    {g.caption && <figcaption>{g.caption}</figcaption>}
                                                </figure>
                                            ))}
                                        </div>
                                    ) : (
                                        <div class="ev-chars-grid">
                                            {t.characters?.map((c) => (
                                                <div class="ev-char-card">
                                                    {c.portrait ? (
                                                        <button type="button" class="ev-char-avatar has-portrait" data-portrait={c.portrait.src} data-name={c.name}>
                                                            <span class="crop"><img src={c.portrait.src} alt={c.name} loading="lazy" style={imgStyle(c.portrait, 0)} /></span>
                                                            <span class="ev-char-initial">{c.name.charAt(0)}</span>
                                                        </button>
                                                    ) : (
                                                        <span class="ev-char-avatar"><span class="ev-char-initial">{c.name.charAt(0)}</span></span>
                                                    )}
                                                    <h4 class="ev-char-name">{c.name}</h4>
                                                    <p class="ev-char-role">{c.role}</p>
                                                    <div class="divider"><span>⬥</span></div>
                                                    <p class="ev-char-hint">"{c.hint}"</p>
                                                </div>
                                            ))}
                                        </div>
                                    )}
                                </>
                            )}
                        </div>
                    </section>
                ))}
            </div>
        )}
    </div>

    <Prenota k="prenotaEventoText" class="ev-final-cta">
        {cta ? <a href={cta.href} class={`${cta.cls} btn-large`}>{cta.label}</a> : <span />}
        <div class="prenota-locale" slot="extra">
            <p class="prenota-locale-text">Sei un locale, un ristorante o un'associazione?</p>
            <a href={`mailto:${s.email}?subject=${encodeURIComponent(`Portare "${title}" nel mio locale`)}`} class="btn-ghost">
                Porta questa cena con delitto da te →
            </a>
        </div>
    </Prenota>

    <dialog id="ev-photo-dialog" class="ev-photo-dialog" style={`--char-font: ${characterFont ?? "var(--font-title)"}`}>
        <button type="button" class="ev-photo-close" aria-label="Chiudi">✕</button>
        <div class="ev-photo-card" id="ev-photo-card">
            <img id="ev-photo-dialog-img" alt="" />
        </div>
        <p id="ev-photo-dialog-name" class="ev-photo-name"></p>
    </dialog>
</Layout>

<script>
    import "../../scripts/ev-photo-dialog.ts";

    // Schede: senza JS si vedono tutte una sotto l'altra; con JS una alla volta, scelta dall'ancora (#la-storia)
    const box = document.querySelector<HTMLElement>("[data-tabs]");
    if (box) {
        const tabs = [...box.querySelectorAll<HTMLAnchorElement>(".ev-tab")];
        const show = (id: string, focus = false) => {
            const panel = box.querySelector<HTMLElement>(`.ev-panel[id="${CSS.escape(id)}"]`);
            if (!panel) return false;
            box.querySelectorAll(".ev-panel").forEach((p) => p.classList.toggle("on", p === panel));
            tabs.forEach((t) => t.setAttribute("aria-selected", String(t.hash === "#" + id)));
            if (focus) box.scrollIntoView({ behavior: "smooth", block: "start" });
            return true;
        };
        box.classList.add("tabs-on");
        tabs.forEach((t) =>
            t.addEventListener("click", (e) => {
                e.preventDefault();
                history.replaceState(null, "", t.hash);
                show(t.hash.slice(1));
            }),
        );
        if (location.hash) show(decodeURIComponent(location.hash.slice(1)), true);
    }
</script>
