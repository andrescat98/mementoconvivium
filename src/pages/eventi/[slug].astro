---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const eventi = await getCollection("eventi");
    return eventi.map((evento: CollectionEntry<"eventi">) => ({
        params: { slug: evento.id },
        props: { evento },
    }));
}

interface Props {
    evento: CollectionEntry<"eventi">;
}

const { evento } = Astro.props as Props;
const { Content } = await render(evento);
const {
    title,
    theme,
    date,
    guests,
    duration,
    quote,
    location,
    price,
    includes,
    characters,
    status,
    featured,
} = evento.data;

const statusLabel: Record<string, string> = {
    aperto: "Prenota ora",
    "lista-attesa": "Lista d'attesa",
    "coming-soon": "Coming soon",
};

const statusClass: Record<string, string> = {
    aperto: "btn-primary",
    "lista-attesa": "btn-ghost",
    "coming-soon": "btn-ghost",
};
---

<Layout
    title={`${title} · Memento Convivium`}
    description={evento.data.excerpt}
>
    <!-- HERO EVENTO -->
    <section class="ev-hero">
        <div class="ev-hero-vignette" aria-hidden="true"></div>
        <div class="container ev-hero-inner">
            <a href="/#eventi" class="ev-back">
                <span>←</span> Tutti gli eventi
            </a>
            <div class="ev-hero-content">
                <span class="section-label">{theme}</span>
                <h1 class="ev-title">{title}</h1>
                {featured && <span class="ev-badge">Prossimo evento</span>}
                <div class="ev-meta-row">
                    <div class="ev-meta-item">
                        <span class="meta-label">Data</span>
                        <span>{date}</span>
                    </div>
                    <div class="ev-meta-divider">⬥</div>
                    <div class="ev-meta-item">
                        <span class="meta-label">Ospiti</span>
                        <span>{guests}</span>
                    </div>
                    <div class="ev-meta-divider">⬥</div>
                    <div class="ev-meta-item">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="greek-border"></div>
    </section>

    <!-- QUOTE -->
    {
        quote && (
            <section class="ev-quote-section">
                <div class="container">
                    <blockquote class="ev-quote">
                        <span class="quote-mark">"</span>
                        <p>{quote.text}</p>
                        <cite>— {quote.author}</cite>
                    </blockquote>
                </div>
            </section>
        )
    }

    <!-- CORPO NARRATIVO -->
    <section class="section ev-body">
        <div class="container ev-grid">
            <!-- Colonna sinistra: testo -->
            <div class="ev-text">
                <span class="section-label">La storia</span>
                <div class="ev-prose">
                    <Content />
                </div>
            </div>

            <!-- Colonna destra: info box -->
            <aside class="ev-sidebar">
                <!-- Info pratiche -->
                <div class="ev-infobox">
                    <h3 class="ev-infobox-title">Dettagli</h3>
                    <div class="divider"><span>⬥</span></div>

                    {
                        location && (
                            <div class="ev-info-row">
                                <span class="meta-label">Luogo</span>
                                <span>{location}</span>
                            </div>
                        )
                    }
                    <div class="ev-info-row">
                        <span class="meta-label">Data</span>
                        <span>{date}</span>
                    </div>
                    <div class="ev-info-row">
                        <span class="meta-label">Ospiti</span>
                        <span>{guests}</span>
                    </div>
                    <div class="ev-info-row">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>
                    {
                        price && (
                            <div class="ev-info-row">
                                <span class="meta-label">Quota</span>
                                <span>{price}</span>
                            </div>
                        )
                    }

                    {
                        includes && includes.length > 0 && (
                            <div class="ev-includes">
                                <span
                                    class="meta-label"
                                    style="display:block; margin-bottom:.75rem;"
                                >
                                    Include
                                </span>
                                <ul class="ev-includes-list">
                                    {includes.map((item: string) => (
                                        <li>
                                            <span class="ev-check">⬥</span>
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )
                    }

                    <a
                        href="mailto:info@mementoconvivium.it"
                        class={`${statusClass} ev-cta-btn`}
                    >
                        {statusLabel}
                    </a>
                    <p class="ev-cta-note">
                        Oppure scrivici su <a href="https://instagram.com"
                            >Instagram</a
                        >
                    </p>
                </div>
            </aside>
        </div>
    </section>

    <!-- PERSONAGGI -->
    {
        characters && characters.length > 0 && (
            <section class="section ev-characters">
                <div class="container">
                    <div class="section-header">
                        <span class="section-label">I protagonisti</span>
                        <h2>I personaggi della serata</h2>
                        <div class="divider">
                            <span>⬥</span>
                        </div>
                        <p class="ev-characters-sub">
                            Ogni ospite riceverà la propria scheda via email.
                            <br />
                            Questi sono i volti che troverai al banchetto.
                        </p>
                    </div>
                    <div class="ev-chars-grid">
                        {characters.map(
                            (c: {
                                name: string;
                                role: string;
                                hint: string;
                            }) => (
                                <div class="ev-char-card">
                                    <div class="ev-char-initial">
                                        {c.name.charAt(0)}
                                    </div>
                                    <h4 class="ev-char-name">{c.name}</h4>
                                    <p class="ev-char-role">{c.role}</p>
                                    <div class="divider">
                                        <span>⬥</span>
                                    </div>
                                    <p class="ev-char-hint">"{c.hint}"</p>
                                </div>
                            ),
                        )}
                    </div>
                </div>
            </section>
        )
    }

    <!-- CTA FINALE -->
    <section class="section ev-final-cta">
        <div class="container">
            <div class="prenota-inner">
                <div class="prenota-ornament">
                    <span>✦</span><div class="orn-line"></div><span>✦</span>
                </div>
                <span class="section-label">Partecipa</span>
                <h2>Sei pronto a sederti al banchetto?</h2>
                <p>
                    Scrivi per prenotare il tuo posto. Ogni evento è a numero
                    chiuso.
                </p>
                <a
                    href="mailto:info@mementoconvivium.it"
                    class={`${statusClass} btn-large`}
                >
                    {statusLabel}
                </a>
                <p class="prenota-note">
                    Oppure scrivici su <a href="https://instagram.com"
                        >Instagram</a
                    >
                </p>
                <div class="prenota-ornament">
                    <span>✦</span><div class="orn-line"></div><span>✦</span>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* ── Hero evento ── */
    .ev-hero {
        padding-top: 8rem;
        padding-bottom: 4rem;
        background: var(--bg-2);
        border-bottom: 1px solid var(--border);
        position: relative;
    }

    .ev-hero-vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at 60% 0%,
            rgba(139, 105, 20, 0.06) 0%,
            transparent 70%
        );
        pointer-events: none;
    }

    .ev-hero-inner {
        position: relative;
        z-index: 1;
    }

    .ev-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-title);
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold-dim);
        text-decoration: none;
        margin-bottom: 2.5rem;
        transition: color 0.3s;
    }

    .ev-back:hover {
        color: var(--gold);
    }

    .ev-hero-content {
        max-width: 700px;
    }

    .ev-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3.8rem);
        font-weight: 400;
        color: var(--white);
        line-height: 1.1;
        margin: 0.75rem 0 1.5rem;
    }

    .ev-badge {
        display: inline-block;
        font-family: var(--font-title);
        font-size: 0.6rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--bg);
        background: var(--gold);
        padding: 0.25rem 0.75rem;
        margin-bottom: 1rem;
    }

    .ev-meta-row {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1rem;
    }

    .ev-meta-item {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        font-size: 0.95rem;
    }

    .ev-meta-divider {
        color: var(--gold-dim);
        font-size: 0.5rem;
        opacity: 0.5;
    }

    /* ── Quote ── */
    .ev-quote-section {
        padding: 3.5rem 0;
        border-bottom: 1px solid var(--border);
    }

    .ev-quote {
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
        position: relative;
    }

    .ev-quote .quote-mark {
        font-family: var(--font-display);
        font-size: 5rem;
        color: var(--gold-dim);
        line-height: 0;
        position: absolute;
        top: 1.5rem;
        left: -2rem;
        opacity: 0.35;
    }

    .ev-quote p {
        font-size: 1.25rem;
        font-style: italic;
        color: var(--cream);
        line-height: 1.8;
        margin-bottom: 1rem;
    }

    .ev-quote cite {
        font-family: var(--font-title);
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--gold);
        font-style: normal;
    }

    /* ── Body grid ── */
    .ev-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 4rem;
        align-items: start;
    }

    /* ── Testo narrativo ── */
    .ev-text .section-label {
        margin-bottom: 1.5rem;
    }

    .ev-prose {
        font-size: 1.1rem;
        line-height: 1.85;
        color: var(--cream);
    }

    .ev-prose p {
        margin-bottom: 1.4rem;
    }

    .ev-prose strong {
        color: var(--white);
        font-weight: 600;
    }

    .ev-prose em {
        color: var(--cream-dim);
        font-style: italic;
    }

    /* ── Sidebar infobox ── */
    .ev-infobox {
        border: 1px solid var(--border);
        background: var(--bg-card);
        padding: 2rem;
        position: sticky;
        top: 6rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .ev-infobox-title {
        font-size: 1rem;
        color: var(--white);
        letter-spacing: 0.1em;
    }

    .ev-info-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
        padding: 0.4rem 0;
        border-bottom: 1px solid var(--border);
    }

    .ev-info-row:last-of-type {
        border-bottom: none;
    }

    .ev-includes {
        padding-top: 0.5rem;
    }

    .ev-includes-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.88rem;
        color: var(--cream-dim);
    }

    .ev-includes-list li {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
    }

    .ev-check {
        color: var(--gold);
        font-size: 0.45rem;
        flex-shrink: 0;
        position: relative;
        top: -1px;
    }

    .ev-cta-btn {
        display: block;
        text-align: center;
        margin-top: 0.5rem;
    }

    .ev-cta-note {
        font-size: 0.8rem;
        color: var(--gold-dim);
        text-align: center;
    }

    .ev-cta-note a {
        color: var(--gold);
        text-decoration: none;
    }

    .ev-cta-note a:hover {
        text-decoration: underline;
    }

    /* ── Personaggi ── */
    .ev-characters {
        background: var(--bg-2);
        border-top: 1px solid var(--border);
    }

    .ev-characters-sub {
        color: var(--cream-dim);
        font-size: 1rem;
        line-height: 1.7;
        margin-top: 0.5rem;
    }

    .ev-chars-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1px;
        background: var(--border);
        margin-top: 1rem;
    }

    .ev-char-card {
        background: var(--bg-card);
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        transition: background 0.3s;
    }

    .ev-char-card:hover {
        background: var(--bg-2);
    }

    .ev-char-initial {
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--gold);
        opacity: 0.45;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .ev-char-name {
        font-size: 1rem;
        color: var(--white);
        letter-spacing: 0.05em;
    }

    .ev-char-role {
        font-family: var(--font-title);
        font-size: 0.62rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 0.25rem;
    }

    .ev-char-hint {
        font-size: 0.9rem;
        font-style: italic;
        color: var(--cream-dim);
        line-height: 1.6;
    }

    /* ── CTA finale ── */
    .ev-final-cta {
        border-top: 1px solid var(--border);
        text-align: center;
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .ev-grid {
            grid-template-columns: 1fr;
            gap: 2.5rem;
        }

        .ev-infobox {
            position: static;
        }
    }

    @media (max-width: 600px) {
        .ev-hero {
            padding-top: 6rem;
        }

        .ev-meta-row {
            gap: 1rem;
        }

        .ev-meta-divider {
            display: none;
        }

        .ev-quote .quote-mark {
            display: none;
        }
    }
</style>
