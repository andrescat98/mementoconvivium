---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import "../../styles/evento.css";

export async function getStaticPaths() {
    // Le cene coming-soon non hanno una pagina dedicata
    const eventi = (await getCollection("eventi")).filter(
        (e: CollectionEntry<"eventi">) => e.data.status !== "coming-soon",
    );
    return eventi.map((evento: CollectionEntry<"eventi">) => ({
        params: { slug: evento.id },
        props: { evento },
    }));
}

interface Props {
    evento: CollectionEntry<"eventi">;
}

const { evento } = Astro.props as Props;
const { Content } = await render(evento);
const {
    title,
    theme,
    dates,
    duration,
    location,
    price,
    includes,
    characters,
    status,
    characterFont,
} = evento.data;

const today = new Date();
today.setHours(0, 0, 0, 0);

const nextDate = dates?.find(
    (d: { dateISO: string }) => new Date(d.dateISO) >= today,
);

const displayDate = nextDate?.label ?? dates?.[0]?.label ?? "Da annunciare";
const displayDateISO = nextDate?.dateISO ?? null;

const statusLabel =
    status === "aperto"
        ? "Prenota ora"
        : status === "lista-attesa"
          ? "Lista d'attesa"
          : status === "chiuso"
            ? "Prenotazioni chiuse"
            : "Coming soon";

const statusClass = status === "aperto" ? "btn-primary" : "btn-ghost";

// characterFont es. "Rye, cursive" → carica "Rye" da Google Fonts per questa pagina.
// I font base sono già nel global.css: non li ricarichiamo. Font non-Google (@font-face
// locale) vanno elencati qui per non provare a caricarli da Google.
const LOCAL_OR_BASE = ["Cinzel", "Cinzel Decorative", "Cormorant Garamond", "Jack Pirate"];
const fontFamily = characterFont?.split(",")[0].trim().replace(/['"]/g, "");
const fontHref =
    fontFamily && !LOCAL_OR_BASE.includes(fontFamily)
        ? `https://fonts.googleapis.com/css2?family=${fontFamily.replace(/ /g, "+")}&display=swap`
        : undefined;

---

<Layout
    title={`${title} · Memento Convivium`}
    description={evento.data.excerpt}
    fontHref={fontHref}
>
    <!-- HERO EVENTO -->
    <section class="ev-hero">
        <div class="ev-hero-vignette" aria-hidden="true"></div>
        <div class="container ev-hero-inner">
            <a href="/#eventi" class="ev-back">
                <span>←</span> Tutti gli eventi
            </a>
            <div class="ev-hero-content">
                <span class="section-label">{theme}</span>
                <h1 class="ev-title">{title}</h1>
                <div class="ev-meta-row">
                    <div class="ev-meta-item">
                        <span class="meta-label">Data</span>
                        <span>{displayDate}</span>
                    </div>
                    <div class="ev-meta-divider">⬥</div>
                    <div class="ev-meta-item">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="greek-border"></div>
    </section>

    <!-- CORPO NARRATIVO -->
    <section class="section ev-body">
        <div class="container ev-grid">
            <!-- Colonna sinistra: testo -->
            <div class="ev-text">
                <span class="section-label">La storia</span>
                <div class="ev-prose">
                    <Content />
                </div>
            </div>

            <!-- Colonna destra: info box -->
            <aside class="ev-sidebar">
                <!-- Info pratiche -->
                <div class="ev-infobox">
                    <h3 class="ev-infobox-title">Dettagli</h3>
                    <div class="divider"><span>⬥</span></div>

                    {dates && dates.length > 0 ? (
                        <div class="ev-date-boxes">
                            {dates.map((d: { label: string; dateISO: string; location?: string; price?: string }) => {
                                const isPast = new Date(d.dateISO) < today;
                                return (
                                    <div class={`ev-date-box${isPast ? " ev-date-box-past" : ""}`}>
                                        <div class="ev-date-box-label">{d.label}</div>
                                        {d.location && <div class="ev-date-box-info"><span class="meta-label">Luogo</span>{d.location}</div>}
                                        {d.price && <div class="ev-date-box-info"><span class="meta-label">Quota</span>{d.price}</div>}
                                    </div>
                                );
                            })}
                        </div>
                    ) : (
                        <>
                            <div class="ev-info-row">
                                <span class="meta-label">Data</span>
                                <span>Da annunciare</span>
                            </div>
                            {location && (
                                <div class="ev-info-row">
                                    <span class="meta-label">Luogo</span>
                                    <span>{location}</span>
                                </div>
                            )}
                            {price && (
                                <div class="ev-info-row">
                                    <span class="meta-label">Quota</span>
                                    <span>{price}</span>
                                </div>
                            )}
                        </>
                    )}
                    <div class="ev-info-row">
                        <span class="meta-label">Durata</span>
                        <span>{duration}</span>
                    </div>

                    {
                        includes && includes.length > 0 && (
                            <div class="ev-includes">
                                <span
                                    class="meta-label"
                                    style="display:block; margin-bottom:.75rem;"
                                >
                                    Include
                                </span>
                                <ul class="ev-includes-list">
                                    {includes.map((item: string) => (
                                        <li>
                                            <span class="ev-check">⬥</span>
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )
                    }

                    <a
                        id="ev-prenota-btn"
                        href="mailto:info@mementoconvivium.it"
                        class={`${statusClass} ev-cta-btn`}
                    >
                        {statusLabel}
                    </a>
                    <p class="ev-cta-note">
                        Oppure scrivici su <a href="https://www.instagram.com/memento_convivium"
                            >Instagram</a
                        >
                    </p>
                </div>
            </aside>
        </div>
    </section>

    <!-- PERSONAGGI -->
    {
        characters && characters.length > 0 && (
            <section class="section ev-characters">
                <div class="container">
                    <div class="section-header">
                        <span class="section-label">I protagonisti</span>
                        <h2>I personaggi della serata</h2>
                        <div class="divider">
                            <span>⬥</span>
                        </div>
                        <p class="ev-characters-sub">
                            Ogni ospite riceverà la propria scheda via email.
                            <br />
                            Questi sono i volti che troverai al banchetto.
                        </p>
                    </div>
                    <div class="ev-chars-grid">
                        {characters.map(
                            (c: {
                                name: string;
                                role: string;
                                hint: string;
                                portrait?: string;
                            }) => (
                                <div class="ev-char-card">
                                    <button
                                        type="button"
                                        class={`ev-char-avatar${c.portrait ? " has-portrait" : ""}`}
                                        data-portrait={
                                            c.portrait
                                                ? `/eventi/${evento.id}/${c.portrait}`
                                                : undefined
                                        }
                                        data-name={c.name}
                                    >
                                        {c.portrait && (
                                            <img
                                                class="ev-char-portrait"
                                                src={`/eventi/${evento.id}/${c.portrait}`}
                                                alt={c.name}
                                                loading="lazy"
                                            />
                                        )}
                                        <span class="ev-char-initial">
                                            {c.name.charAt(0)}
                                        </span>
                                    </button>
                                    <h4 class="ev-char-name">{c.name}</h4>
                                    <p class="ev-char-role">{c.role}</p>
                                    <div class="divider">
                                        <span>⬥</span>
                                    </div>
                                    <p class="ev-char-hint">"{c.hint}"</p>
                                </div>
                            ),
                        )}
                    </div>
                </div>
            </section>
        )
    }

    <!-- CTA FINALE -->
    <section class="section ev-final-cta">
        <div class="container">
            <div class="prenota-inner">
                <div class="prenota-ornament">
                    <span>✦</span>
                </div>
                <span class="section-label">Partecipa</span>
                <h2>Sei pronto a sederti al banchetto?</h2>
                <p>
                    Riserva il tuo posto al tavolo: scrivici e ti racconteremo
                    come unirti alla prossima serata. Ogni evento è a numero
                    chiuso e i posti vanno in fretta.
                </p>
                <a
                    href="mailto:info@mementoconvivium.it"
                    class={`${statusClass} btn-large`}
                >
                    {statusLabel}
                </a>
                <p class="prenota-note">
                    Oppure scrivici su <a href="https://www.instagram.com/memento_convivium"
                        >Instagram</a
                    >
                </p>

                <div class="prenota-locale">
                    <p class="prenota-locale-text">
                        Sei un locale, un ristorante o un'associazione?
                    </p>
                    <a
                        href="mailto:info@mementoconvivium.it?subject=Portare%20questa%20cena%20con%20delitto%20nel%20mio%20locale"
                        class="btn-ghost"
                    >
                        Porta questa cena con delitto da te →
                    </a>
                </div>
                <div class="prenota-ornament">
                    <span>✦</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FULLSCREEN RITRATTO -->
    <dialog
        id="ev-photo-dialog"
        class="ev-photo-dialog"
        style={`--char-font: ${characterFont ?? "var(--font-title)"}`}
    >
        <button type="button" class="ev-photo-close" aria-label="Chiudi">✕</button>
        <div class="ev-photo-card" id="ev-photo-card">
            <img id="ev-photo-dialog-img" alt="" />
        </div>
        <p id="ev-photo-dialog-name" class="ev-photo-name"></p>
    </dialog>
</Layout>

<script define:vars={{ displayDateISO }}>
    // Nascondi il bottone prenota se non ci sono date future disponibili
    if (displayDateISO) {
        const eventDate = new Date(displayDateISO);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (eventDate < today) {
            const btn = document.getElementById("ev-prenota-btn");
            if (btn) btn.style.display = "none";
        }
    }
</script>

<script>
    import "../../scripts/ev-photo-dialog.ts";
</script>

