---
import { getCollection } from "astro:content";

const tuttiEventi = await getCollection("eventi");
const oggi = new Date().toISOString().slice(0, 10);

// Ordina per data crescente (TBA in fondo)
const eventi = tuttiEventi.sort((a, b) => {
    const aISO = a.data.dateISO;
    const bISO = b.data.dateISO;
    if (aISO && bISO) return aISO.localeCompare(bISO);
    if (aISO) return -1;
    if (bISO) return 1;
    return 0;
});

// Prossimo = primo con data futura, poi featured, poi primo in lista
const prossimo =
    eventi.find((e) => e.data.dateISO && e.data.dateISO >= oggi) ??
    eventi.find((e) => e.data.featured) ??
    eventi[0];

const slug = prossimo.id;
---

<!doctype html>
<html lang="it">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0; url=/eventi/${slug}`} />
        <title>Redirecting…</title>
        <script define:vars={{ slug }}>
            window.location.replace("/eventi/" + slug);
        </script>
    </head>
    <body></body>
</html>
