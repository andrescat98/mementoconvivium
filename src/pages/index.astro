---
// Home: lista di blocchi da /admin → Pagine del sito → Home (predefinita: intestazione, come funziona, timeline, prenota)
import Layout from "../layouts/Layout.astro";
import Blocco from "../components/Blocco.astro";
import FotoDialog from "../components/FotoDialog.astro";
import { getEvents, getSettings } from "../lib/db";

const [eventi, s] = await Promise.all([getEvents(), getSettings()]);
---

<Layout title="Memento Convivium" description="Cene con Delitto a Tema Storico" sfondo={s.sfondoHome}>
    {s.home.filter((b) => !b.hidden).map((b) => <Blocco b={b} eventi={eventi} />)}
    <FotoDialog />
</Layout>
