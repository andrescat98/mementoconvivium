---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";
import "../styles/timeline.css";
import TimelineSection from "../components/TimelineSection.astro";

const tuttiEventi = await getCollection("eventi");
const eventi = tuttiEventi.sort((a, b) => {
    const aISO = a.data.dateISO;
    const bISO = b.data.dateISO;
    if (aISO && bISO) return aISO.localeCompare(bISO);
    if (aISO) return -1;
    if (bISO) return 1;
    return 0;
});

const oggi = new Date().toISOString().slice(0, 10);
const prossimo =
    eventi.find((e) => e.data.dateISO && e.data.dateISO >= oggi) ??
    eventi.find((e) => e.data.featured) ??
    eventi[0];
---

<Layout title="Memento Convivium" description="Cene con Delitto a Tema Storico">
    <!-- HERO -->
    <section class="hero">
        <div class="hero-vignette" aria-hidden="true"></div>
        <div class="hero-content">
            <div class="hero-logo animate" style="--d:0.2s">
                <span class="logo-m">M</span>
                <span class="logo-full">Memento Convivium</span>
            </div>
            <a href={`/eventi/${prossimo.id}`} class="hero-cta">
                <svg
                    width="20px"
                    height="20px"
                    viewBox="0 0 512 512"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        fill="currentColor"
                        d="M43.53 15.75c-15.73 0-28.31 12.583-28.31 28.313 0 14.086 10.092 25.644 23.5 27.906L42.687 68 68.81 41.906l2.626-2.625C69.188 25.86 57.63 15.75 43.53 15.75zm33.72 44.125l-17 17c15.885 39.37 43.45 66.684 78.75 87.406 8.167-8.585 16.65-16.898 25.438-24.936-22.488-35.103-51.535-62.294-87.188-79.47zM322.594 79.03l-51.25 4.314c-79.356 48.134-143.878 108.1-186.72 186.53l-4.31 51.47 44.155-18.656-2.94-34.094-.25-3.063 1.626-2.624c35.94-58.47 79.93-109.41 141.5-141.25l2.406-1.25 2.688.25 34.125 2.906 18.97-44.53zm-62.438 66.376c-10.008 5.886-19.5 12.338-28.562 19.313 46.688 47.93 87.208 108.588 114.72 166.5l11.248 23.717-23.718-11.28c-57.995-27.554-117.918-67.57-165.688-113.907-7.155 9.404-14.028 19.174-20.625 29.28 101.918 94.91 227.05 177.304 347.845 234.69-57.063-120.125-140.038-246.18-235.22-348.314zm-43.03 31.22c-13.37 11.703-25.72 24.58-37.282 38.436 39.36 38.452 88.085 72.83 136.687 98.844-26.054-48.633-60.754-97.847-99.405-137.28z"
                    ></path>
                </svg>
                Partecipa al prossimo evento
            </a>
        </div>
    </section>

    <!-- COME FUNZIONA -->
    <section class="section come-funziona" id="come-funziona">
        <div class="container">
            <div class="section-header">
                <span class="section-label">Il rituale</span>
                <h2>Come funziona</h2>
                <div class="divider"><span>⬥</span></div>
            </div>
            <div class="steps">
                <div class="step">
                    <div class="step-num">I</div>
                    <div class="step-body">
                        <h3>Vesti il tuo ruolo</h3>
                        <p>
                            Indossa abiti ispirati all'epoca e lasciati
                            avvolgere dall'atmosfera della serata. Ogni
                            dettaglio del tuo look contribuirà a rendere
                            l'esperienza più autentica, immersiva e memorabile.
                        </p>
                    </div>
                </div>
                <div class="step-connector">
                    <div class="connector-line"></div>
                    <span class="connector-gem">◆</span>
                    <div class="connector-line"></div>
                </div>
                <div class="step">
                    <div class="step-num">II</div>
                    <div class="step-body">
                        <h3>La cena accompagna il mistero</h3>
                        <p>
                            Lo spettacolo prende vita durante la cena: tra una
                            portata e l'altra, la storia si sviluppa, gli indizi
                            emergono e gli ospiti vengono accompagnati in
                            un'esperienza coinvolgente.
                        </p>
                    </div>
                </div>
                <div class="step-connector">
                    <div class="connector-line"></div>
                    <span class="connector-gem">◆</span>
                    <div class="connector-line"></div>
                </div>
                <div class="step">
                    <div class="step-num">III</div>
                    <div class="step-body">
                        <h3>La storia prende vita</h3>
                        <p>
                            Attori in costume interpretano personaggi dell'epoca
                            e danno forma al racconto. Scene, dialoghi ed eventi
                            si susseguono, facendo rivivere agli ospiti
                            l'atmosfera, i segreti e i conflitti del passato.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TIMELINE -->
    <TimelineSection events={eventi} />

    <!-- CTA PRENOTA -->
    <section class="section prenota" id="prenota">
        <div class="container">
            <div class="prenota-inner">
                <div class="prenota-ornament">
                    <span>✦</span>
                    <div class="orn-line"></div>
                    <span>✦</span>
                </div>
                <span class="section-label">Partecipa</span>
                <h2>Sei pronto a sederti al banchetto?</h2>
                <p>
                    Scrivi per prenotare il tuo posto o richiedere informazioni.<br
                    />
                    Ogni evento è a numero chiuso.
                </p>
                <a
                    href="mailto:info@mementoconvivium.it"
                    class="btn-primary btn-large"
                >
                    Contattaci
                </a>
                <p class="prenota-note">
                    Oppure scrivici su <a href="https://instagram.com"
                        >Instagram</a
                    >
                </p>
                <div class="prenota-ornament">
                    <span>✦</span>
                    <div class="orn-line"></div>
                    <span>✦</span>
                </div>
            </div>
        </div>
    </section>
</Layout>
